# The recording container for grofe's tmux argv corpus (plan M3.6, TC.0).
#
# tmux 3.7b built from source (distributions ship 3.7c or older), checked by
# hash and by `tmux -V`, installed OFF the PATH at /opt/tmux/bin/tmux so that
# the only `tmux` a script can find is the recorder. The tools the owner's
# setup drives tmux with are pinned to the owner's versions: fzf (whose
# `--tmux` builds the popup argv), smug, and opensessions' prebuilt binaries.
#
# Nothing of the owner's is baked in: scripts/record-container-corpus.sh
# mounts a scrubbed copy of canopy, the athome files and the plugins read-only
# at /src when it runs the image.
FROM docker.io/library/debian:stable-slim

ARG TMUX_VERSION=3.7b
ARG TMUX_SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96
ARG FZF_VERSION=0.74.4
ARG SMUG_VERSION=0.3.19
ARG OPENSESSIONS_VERSION=0.2.0-alpha.12

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash bison build-essential ca-certificates curl gawk git iproute2 \
    libevent-dev libncurses-dev locales ncurses-term pkg-config procps \
    python3 zoxide \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/tmux.tar.gz \
    "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
  && echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c - \
  && tar -C /tmp -xzf /tmp/tmux.tar.gz \
  && cd "/tmp/tmux-${TMUX_VERSION}" \
  && ./configure --prefix=/opt/tmux >/dev/null \
  && make -j"$(nproc)" >/dev/null \
  && make install >/dev/null \
  && rm -rf /tmp/tmux* \
  && test "$(/opt/tmux/bin/tmux -V)" = "tmux ${TMUX_VERSION}"

RUN set -e; \
  case "$(uname -m)" in \
    aarch64|arm64) fzf_arch=arm64 smug_arch=arm64 triple=aarch64-unknown-linux-gnu ;; \
    x86_64|amd64) fzf_arch=amd64 smug_arch=x86_64 triple=x86_64-unknown-linux-gnu ;; \
    *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_${fzf_arch}.tar.gz" \
    | tar -xz -C /usr/local/bin fzf; \
  curl -fsSL -o /usr/local/bin/fzf-tmux "https://raw.githubusercontent.com/junegunn/fzf/v${FZF_VERSION}/bin/fzf-tmux"; \
  chmod 755 /usr/local/bin/fzf-tmux; \
  curl -fsSL "https://github.com/ivaaaan/smug/releases/download/v${SMUG_VERSION}/smug_${SMUG_VERSION}_Linux_${smug_arch}.tar.gz" \
    | tar -xz -C /usr/local/bin smug; \
  mkdir -p /opt/opensessions-bin; \
  curl -fsSL "https://github.com/ataraxy-labs/opensessions/releases/download/v${OPENSESSIONS_VERSION}/opensessions-sidebar-${triple}.tar.gz" \
    | tar -xz -C /opt/opensessions-bin; \
  printf '%s\n' "${OPENSESSIONS_VERSION}" >/opt/opensessions-bin/.opensessions-version; \
  fzf --version | grep -q "^${FZF_VERSION} "

RUN sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen && locale-gen >/dev/null \
  && useradd -m -s /bin/bash rec

USER rec
ENV HOME=/home/rec LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 TERM=xterm-256color SHELL=/bin/bash
WORKDIR /home/rec
