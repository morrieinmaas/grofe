# The Debian e2e image (plan T4.6), the one every container scenario must
# pass on. Built only by scripts/e2e.sh, from a context holding nothing but
# grofe at HEAD as a `git archive` export:
#
#   grofe/    grofe at HEAD, built in the first stage
#
# No systemd: PID 1 is podman's --init and a sleep, so `podman restart`
# kills every process and the scenario's next phase "boots" by hand, as a
# login unit would. grofe is /usr/local/lib/grofe/grofe with `grofe` and
# `tmux` symlinks in /usr/bin, so a boot with PATH=/usr/bin:/bin finds them.
# fake-agent sits in /opt/e2e/bin only, on the setter's PATH and never on
# the boot's. Both bases are pinned by digest.
FROM docker.io/library/rust:1.98-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS build

ENV CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never
WORKDIR /src
COPY grofe/ /src/
RUN cargo build --release --locked --bin grofe \
  && mkdir -p /out \
  && cp target/release/grofe /out/grofe

# The acceptance stage (plan TE.1), built only for a scenario that names
# it (`# e2e-target: acceptance`), so the last stage below stays the image
# every other scenario gets. It holds the toolchain, grofe's source at HEAD
# under the test user's home with the acceptance suite and the debug binary
# already built, and the spec 8 tools: neovim, fzf, less, htop, git, kitten
# (Debian's kitty package), bats. Real tmux 3.7b is built from the release
# tarball, pinned by the sha256 containers/compat/golden.Containerfile
# uses, into /usr/local/lib/tmux-3.7b, never /usr/bin: there `tmux` is
# grofe, as in the image below.
FROM docker.io/library/rust:1.98-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS acceptance

ARG TMUX_VERSION=3.7b
ARG TMUX_SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash bats bison ca-certificates curl fzf git htop jq \
    kitty less libevent-dev libncurses-dev lsof make neovim pkg-config procps python3 \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/tmux.tar.gz \
    "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
  && echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c - \
  && mkdir /tmp/tmux && tar -xzf /tmp/tmux.tar.gz -C /tmp/tmux --strip-components=1 \
  && cd /tmp/tmux && ./configure --prefix="/usr/local/lib/tmux-${TMUX_VERSION}" && make -j"$(nproc)" && make install \
  && cd / && rm -rf /tmp/tmux /tmp/tmux.tar.gz \
  && test "$("/usr/local/lib/tmux-${TMUX_VERSION}/bin/tmux" -V)" = "tmux ${TMUX_VERSION}"

RUN useradd -m -u 1000 -s /bin/bash test
COPY --chown=test:test grofe/ /home/test/grofe/
USER test
ENV CARGO_HOME=/home/test/.cargo CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never
WORKDIR /home/test/grofe
RUN cargo test --locked --test acceptance --no-run && cargo build --locked --bin grofe
USER root
RUN install -D -m 0755 /home/test/grofe/target/debug/grofe /usr/local/lib/grofe/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/tmux
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e

ENV LANG=C.UTF-8
WORKDIR /
CMD ["sleep", "infinity"]

FROM docker.io/library/debian:stable-slim@sha256:5bc3287b25407c965a30f38e32603dc253a3869e1b12a21ac09bfc27fd8b13ce

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash jq procps \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash test

COPY --from=build /out/grofe /usr/local/lib/grofe/grofe
RUN ln -s /usr/local/lib/grofe/grofe /usr/bin/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/tmux
COPY grofe/tests/fixtures/fake-agent /opt/e2e/bin/fake-agent
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e && chmod 755 /opt/e2e/bin/fake-agent

ENV LANG=C.UTF-8
CMD ["sleep", "infinity"]
