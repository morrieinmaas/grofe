# The Debian e2e image (plan T4.6), the one every container scenario must
# pass on. Built only by scripts/e2e.sh, from a context holding nothing but
# grofe at HEAD as a `git archive` export and, for the stages whose
# scenario declares them (`# e2e-inputs:`), canopy and athome at their
# pinned commits:
#
#   grofe/                  grofe at HEAD, built in the first stage
#   inputs/canopy.bundle    canopy's pinned commit as branch `pinned`
#   inputs/canopy/          its tree (compat stage)
#   inputs/athome/          athome's tree at its pinned commit (compat)
#
# No systemd: PID 1 is podman's --init and a sleep, so `podman restart`
# kills every process and the scenario's next phase "boots" by hand, as a
# login unit would. grofe is /usr/local/lib/grofe/grofe with `grofe` and
# `tmux` symlinks in /usr/bin, so a boot with PATH=/usr/bin:/bin finds them.
# fake-agent sits in /opt/e2e/bin only, on the setter's PATH and never on
# the boot's. Both bases are pinned by digest.
FROM docker.io/library/rust:1.98-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS build

ENV CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never
WORKDIR /src
COPY grofe/ /src/
RUN cargo build --release --locked --bin grofe \
  && mkdir -p /out \
  && cp target/release/grofe /out/grofe

# The acceptance stage (plan TE.1), built only for a scenario that names
# it (`# e2e-target: acceptance`), so the last stage below stays the image
# every other scenario gets. It holds the toolchain, grofe's source at HEAD
# under the test user's home with the acceptance suite and the debug binary
# already built, the spec 8 tools: neovim, fzf, less, htop, git, kitten
# (Debian's kitty package), bats, and the plugin cases' release binaries,
# provisioned from canopy at its pinned commit. Real tmux 3.7b is built
# from the release
# tarball, pinned by the sha256 containers/compat/golden.Containerfile
# uses, into /usr/local/lib/tmux-3.7b, never /usr/bin: there `tmux` is
# grofe, as in the image below.
FROM docker.io/library/rust:1.98-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS acceptance

ARG TMUX_VERSION=3.7b
ARG TMUX_SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash bats bison ca-certificates curl fzf git htop jq \
    kitty less libevent-dev libncurses-dev lsof make neovim pkg-config procps python3 \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/tmux.tar.gz \
    "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
  && echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c - \
  && mkdir /tmp/tmux && tar -xzf /tmp/tmux.tar.gz -C /tmp/tmux --strip-components=1 \
  && cd /tmp/tmux && ./configure --prefix="/usr/local/lib/tmux-${TMUX_VERSION}" && make -j"$(nproc)" && make install \
  && cd / && rm -rf /tmp/tmux /tmp/tmux.tar.gz \
  && test "$("/usr/local/lib/tmux-${TMUX_VERSION}/bin/tmux" -V)" = "tmux ${TMUX_VERSION}"

RUN useradd -m -u 1000 -s /bin/bash test
# canopy at its pinned commit, a clone of the bundle scripts/e2e.sh made
# (`# e2e-inputs: canopy`), and the release binaries TP.8's and TP.9's
# cases run against, provisioned from it by canopy's own checksum-verified
# function before grofe's source comes in, so a grofe change reuses them.
COPY --chown=test:test inputs/canopy.bundle /tmp/canopy.bundle
COPY grofe/scripts/provision-plugin-binaries.sh /usr/local/lib/e2e/provision-plugin-binaries.sh
USER test
RUN git clone --quiet --branch pinned /tmp/canopy.bundle /home/test/compat/canopy \
  && /usr/local/lib/e2e/provision-plugin-binaries.sh /home/test/compat/canopy /home/test/compat/plugins
ENV GROFE_TEST_OPENSESSIONS=/home/test/compat/plugins/store/plugins/opensessions/bin \
  GROFE_TEST_XRE=/home/test/compat/plugins/store/plugins/tmux-fzf-url/bin/xre
USER root
COPY --chown=test:test grofe/ /home/test/grofe/
USER test
# Line tables only and no incremental cache: a backtrace keeps its
# file:line, and target/ in the image is much smaller.
ENV CARGO_HOME=/home/test/.cargo CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never \
  CARGO_PROFILE_DEV_DEBUG=line-tables-only CARGO_INCREMENTAL=0
WORKDIR /home/test/grofe
RUN cargo test --locked --test acceptance --no-run && cargo build --locked --bin grofe
USER root
RUN install -D -m 0755 /home/test/grofe/target/debug/grofe /usr/local/lib/grofe/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/tmux
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e

ENV LANG=C.UTF-8
WORKDIR /
CMD ["sleep", "infinity"]

# The compat stage (plan TE.2), for `# e2e-target: compat`: TC.13's suite,
# TM.7's parity suite and TC.0b's recorder. The recorder replays every
# golden on real tmux with PATH=/usr/local/bin:/usr/bin:/bin, so what those
# directories hold is part of what it records (a pane script finds fzf, or
# says it is required): the stage is containers/compat/golden.Containerfile
# again, the same base, packages and the two tmux 3.7b builds at
# /usr/local/bin/tmux and tmux-sixel, and not the acceptance stage. The
# suites' own tools sit off that PATH, in /opt/compat-tools/bin, which
# compat.sh puts first for the suites only: fzf at the owner's 0.74.4
# (containers/compat/Containerfile's pin; TC.13's `fzf --tmux` check needs
# one that opens a floating pane, and Debian's 0.60 opens a popup) and
# Neovim 0.10.4's release build (Debian trixie's version) for the
# navigator check. canopy and athome are their exported trees at the PINS
# commits, in ~/compat for the suites and in tests/compat/scenarios/trees
# for the recorder. `golden` (uid 1001) is the recorder's user name, which
# normalization replaces: compat.sh maps the test user onto it.
FROM docker.io/library/rust:1.98-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS compat

ARG TMUX_VERSION=3.7b
ARG TMUX_SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96
ARG FZF_VERSION=0.74.4
ARG NVIM_VERSION=0.10.4
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bison ca-certificates curl libevent-dev libncurses-dev make pkg-config \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/tmux.tar.gz \
    "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
  && echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c - \
  && mkdir /tmp/tmux && tar -xzf /tmp/tmux.tar.gz -C /tmp/tmux --strip-components=1 \
  && cd /tmp/tmux && ./configure --prefix=/usr/local && make -j"$(nproc)" && make install \
  && make distclean && ./configure --prefix=/opt/tmux-sixel --enable-sixel && make -j"$(nproc)" && make install \
  && cd / && rm -rf /tmp/tmux /tmp/tmux.tar.gz \
  && ln -s /opt/tmux-sixel/bin/tmux /usr/local/bin/tmux-sixel \
  && test "$(/usr/local/bin/tmux -V)" = "tmux ${TMUX_VERSION}" \
  && test "$(/usr/local/bin/tmux-sixel -V)" = "tmux ${TMUX_VERSION}"
RUN case "$(uname -m)" in \
    aarch64|arm64) fzf_arch=arm64 nvim_arch=arm64 \
      fzf_sha=5d673b849f494f0d64ec471d8640b153ca8849e3846a31da17abdcfce8df6b46 \
      nvim_sha=c819bf47a9878013ba35ceae87125dd170ede4a72844d049fb35f781045872eb ;; \
    x86_64|amd64) fzf_arch=amd64 nvim_arch=x86_64 \
      fzf_sha=05e6813a337cc722c3ed07e54a764b75cc5d671e2e60459db0ba696ee5fa7504 \
      nvim_sha=95aaa8e89473f5421114f2787c13ae0ec6e11ebbd1a13a1bd6fcf63420f8073f ;; \
    *) echo "no fzf or nvim for $(uname -m)" >&2; exit 1 ;; \
  esac \
  && mkdir -p /opt/compat-tools/bin /opt/nvim \
  && curl -fsSLo /tmp/fzf.tar.gz \
    "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_${fzf_arch}.tar.gz" \
  && echo "${fzf_sha}  /tmp/fzf.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/fzf.tar.gz -C /opt/compat-tools/bin fzf \
  && curl -fsSLo /tmp/nvim.tar.gz \
    "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-${nvim_arch}.tar.gz" \
  && echo "${nvim_sha}  /tmp/nvim.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/nvim.tar.gz -C /opt/nvim --strip-components=1 \
  && ln -s /opt/nvim/bin/nvim /opt/compat-tools/bin/nvim \
  && rm /tmp/fzf.tar.gz /tmp/nvim.tar.gz \
  && /opt/compat-tools/bin/fzf --version | grep -q "^${FZF_VERSION} " \
  && /opt/compat-tools/bin/nvim --version | grep -q "^NVIM v${NVIM_VERSION}$"

RUN useradd -m -u 1000 -s /bin/bash test && useradd -M -u 1001 -s /bin/sh golden
COPY --chown=test:test grofe/ /home/test/grofe/
COPY --chown=test:test inputs/canopy/ /home/test/compat/canopy/
COPY --chown=test:test inputs/athome/ /home/test/compat/athome/
COPY --chown=test:test inputs/canopy/ /home/test/grofe/tests/compat/scenarios/trees/canopy/
COPY --chown=test:test inputs/athome/ /home/test/grofe/tests/compat/scenarios/trees/athome/
USER test
ENV CARGO_HOME=/home/test/.cargo CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never \
  CARGO_PROFILE_DEV_DEBUG=line-tables-only CARGO_INCREMENTAL=0
WORKDIR /home/test/grofe
RUN cargo test --locked --test compat --no-run
USER root
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e

ENV LANG=C.UTF-8
WORKDIR /
CMD ["sleep", "infinity"]

FROM docker.io/library/debian:stable-slim@sha256:5bc3287b25407c965a30f38e32603dc253a3869e1b12a21ac09bfc27fd8b13ce

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash jq procps \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash test

COPY --from=build /out/grofe /usr/local/lib/grofe/grofe
RUN ln -s /usr/local/lib/grofe/grofe /usr/bin/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/tmux
COPY grofe/tests/fixtures/fake-agent /opt/e2e/bin/fake-agent
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e && chmod 755 /opt/e2e/bin/fake-agent

ENV LANG=C.UTF-8
CMD ["sleep", "infinity"]
