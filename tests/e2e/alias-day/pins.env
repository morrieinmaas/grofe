# The inputs the alias-day leg (TA.1) runs, read by scripts/e2e-alias-day.sh.
# TE.2's tests/e2e/pins.env takes these over when it lands.
#
# athome's alias-day ref: a branch of the owner's local athome clone that pins
# grofe and canopy, puts the tmux symlink first on PATH and installs grofe's
# config. The runner archives the commit it names, never a working tree.
ATHOME_ALIAS_REF=grofe-config
# canopy at the commit that carries M3.6's and M3.7's port (the plugin loader
# and the grofe fragments). It is the ref= in the archive's run_onchange_18;
# the runner fails when the two differ.
CANOPY_TAG=f54cd1cf4084556d43b9696b97004fda6b824486
CANOPY_SHA=f54cd1cf4084556d43b9696b97004fda6b824486
