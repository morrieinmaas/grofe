# The Arch e2e image (plan T4.6): the owner's Linux, optional
# (scripts/e2e.sh runs it only with E2E_ARCH=1, and it never gates). The
# base is amd64 only; on an arm64 host podman runs it emulated. The same
# shape as Containerfile.debian: grofe at HEAD from a `git archive` export,
# built in the first stage with Arch's own rust; `grofe` and `tmux`
# symlinks in /usr/bin; fake-agent only in /opt/e2e/bin; no systemd. The
# base is pinned by digest; the packages are whatever Arch ships the day
# the image is built (a rolling release has no other pin).
FROM docker.io/library/archlinux:base@sha256:42217d5f09e11d3fe7ad3b309b7fde891d458464dab5d674e629073765610427 AS build

RUN pacman -Syu --noconfirm --needed rust gcc && pacman -Scc --noconfirm
ENV CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never
WORKDIR /src
COPY grofe/ /src/
RUN cargo build --release --locked --bin grofe \
  && mkdir -p /out \
  && cp target/release/grofe /out/grofe

# The acceptance stage (plan TE.1), as in Containerfile.debian: built only
# for a scenario that names it (`# e2e-target: acceptance`); the toolchain,
# grofe's source at HEAD in the test user's home with the acceptance suite
# and the debug binary built, the spec 8 tools from Arch (kitten comes with
# kitty), and real tmux 3.7b from the release tarball, pinned by the sha256
# containers/compat/golden.Containerfile uses, in /usr/local/lib/tmux-3.7b.
FROM docker.io/library/archlinux:base@sha256:42217d5f09e11d3fe7ad3b309b7fde891d458464dab5d674e629073765610427 AS acceptance

ARG TMUX_VERSION=3.7b
ARG TMUX_SHA256=87f2e99e3b685973f2ca002ffd6ed7e51a5744f7009daae5a15670b6d532db96
RUN pacman -Syu --noconfirm --needed bash bats bison curl fzf gcc git htop jq kitty less libevent lsof \
    make ncurses neovim pkgconf procps-ng python rust which \
  && pacman -Scc --noconfirm
RUN curl -fsSLo /tmp/tmux.tar.gz \
    "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
  && echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c - \
  && mkdir /tmp/tmux && tar -xzf /tmp/tmux.tar.gz -C /tmp/tmux --strip-components=1 \
  && cd /tmp/tmux && ./configure --prefix="/usr/local/lib/tmux-${TMUX_VERSION}" && make -j"$(nproc)" && make install \
  && cd / && rm -rf /tmp/tmux /tmp/tmux.tar.gz \
  && test "$("/usr/local/lib/tmux-${TMUX_VERSION}/bin/tmux" -V)" = "tmux ${TMUX_VERSION}"

RUN useradd -m -u 1000 -s /bin/bash test
COPY --chown=test:test grofe/ /home/test/grofe/
USER test
# Line tables only and no incremental cache: a backtrace keeps its
# file:line, and target/ in the image is much smaller.
ENV CARGO_HOME=/home/test/.cargo CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never \
  CARGO_PROFILE_DEV_DEBUG=line-tables-only CARGO_INCREMENTAL=0
WORKDIR /home/test/grofe
RUN cargo test --locked --test acceptance --no-run && cargo build --locked --bin grofe
USER root
RUN install -D -m 0755 /home/test/grofe/target/debug/grofe /usr/local/lib/grofe/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/tmux
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e

ENV LANG=C.UTF-8
WORKDIR /
CMD ["sleep", "infinity"]

FROM docker.io/library/archlinux:base@sha256:42217d5f09e11d3fe7ad3b309b7fde891d458464dab5d674e629073765610427

RUN pacman -Syu --noconfirm --needed bash jq procps-ng && pacman -Scc --noconfirm

RUN useradd -m -u 1000 -s /bin/bash test

COPY --from=build /out/grofe /usr/local/lib/grofe/grofe
RUN ln -s /usr/local/lib/grofe/grofe /usr/bin/grofe \
  && ln -s /usr/local/lib/grofe/grofe /usr/bin/tmux
COPY grofe/tests/fixtures/fake-agent /opt/e2e/bin/fake-agent
COPY grofe/tests/e2e/scenarios/ /opt/e2e/scenarios/
RUN chmod -R a+rX /opt/e2e && chmod 755 /opt/e2e/bin/fake-agent

ENV LANG=C.UTF-8
CMD ["sleep", "infinity"]
