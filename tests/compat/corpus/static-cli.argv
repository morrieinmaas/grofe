show-option -g -q -v @opensessions-prefix-key
show-option -g -q -v @sessionx-_bind-back
show-option -g -q -v @sessionx-_built-args
show-option -g -q -v @sessionx-_built-fzf-opts
show-option -g -q -v @sessionx-_custom-paths
show-option -g -q -v @sessionx-_custom-paths-subdirectories
show-option -g -q -v @sessionx-_filter-current
show-option -g -q -v @sessionx-_filtered-sessions
show-option -g -q -v @sessionx-_fzf-builtin-tmux
show-option -g -q -v @sessionx-_git-branch
show-option -g -q -v @sessionx-_window-mode
show-option -g -q -v @sessionx-git-branch
show-option -g -v -q @tmux-which-key-disable-autobuild
show-option -g -v -q @tmux-which-key-xdg-enable
show-option -g -v -q @tmux-which-key-xdg-plugin-path
show-option -g -v <$option>
show-option -g -v prefix
show-option -g -w -v mode-keys
show-option -s -v <$option>
show-options -g -q -v @claude_parent
show-options -g -q <$option>
show-options -p remain-on-exit \; show-options -p synchronize-panes
show-options -q -v -t <$session> @claude_origin
show-window-options -v -t <$session_name>:<$window_index> automatic-rename
show-window-options remain-on-exit \; show-window-options synchronize-panes
source-file <$(...)>
source-file <$init_file>
source-file <file>
split-window -c <$PWD> <$opt> 'bash -c '"'"'exec -a fzf bash <$argsf>'"'"'' <$swap> <$tmux_off_opts>
split-window -h -b -f -l <width> -t <target> -P -F <pane-format> <command>
split-window -h -f -l <width> -t <target> -P -F <pane-format> <command>
split-window -t <$session_name>:<$window_number> -c <$dir>
split-window -t <$session_name>:<$window_number> -c <$dir> <$pane_creation_command>
split-window -v -l 30% -b 'bash -c '"'"'printf "Session Name: " && read session_name && echo "$session_name" > /tmp/tmux_fzf_session_name'"'"''
split-window -v -l 30% -b 'bash -c '"'"'printf "Window Name: " && read window_name && echo "$window_name" > /tmp/tmux_fzf_window_name'"'"''
split-window -v -l 30% -b -c #{pane_current_path} 'bash -c '"'"'doas kill -s <$1> <$2>'"'"''
split-window -v -l 30% -b -c #{pane_current_path} 'bash -c '"'"'sudo kill -s <$1> <$2>'"'"''
split-window -v -l 50% -b -c #{pane_current_path} 'top -p <$pid>'
split-window -v -l 50% -b -c #{pane_current_path} 'top -pid <$pid>'
start-server
start-server \; show-environment -g TMUX_PLUGIN_MANAGER_PATH
start-server \; show-option -g -q -v <$tpm_plugins_variable_name>
swap-pane -D
swap-pane -s <$target> -t <$target_swap>
swap-pane -t <$original_window> \; select-window -t <$original_window> \; kill-window -t <$tmp_window> \; resize-pane -Z
swap-pane -t <$tmp_window> \; select-window -t <$tmp_window>
swap-window -s <$target> -t <$target_swap>
switch-client -T root
switch-client -c <$parent> -t <$origin>
switch-client -c <$parent> -t <$session>
switch-client -c <client> -t <target>
switch-client -n
switch-client -t <$BASH_REMATCH>
switch-client -t <$client_last_session>
switch-client -t <$client_session>
switch-client -t <$grouped_session>:<$active_window_index>
switch-client -t <$grouped_session>:<$alternate_window_index>
switch-client -t <$name>
switch-client -t <$sel>
switch-client -t <$session>
switch-client -t <$session_name>
switch-client -t <$session_name>:<$window_number>
switch-client -t <$target>
switch-client -t <session>
switch-client -t <target>
unbind-key -T opensessions <$i>
unbind-key -T opensessions Any
unbind-key -T opensessions e
unbind-key -T opensessions s
unbind-key -T opensessions t
unbind-key -n <$FOCUS_GLOBAL_KEY>
unbind-key -n <$key>
unbind-key <$PREFIX_KEY>
unbind-key C-b
unbind-key C-s
unbind-key C-t
unbind-key M-<$i>
unlink-window -k -t <name>
