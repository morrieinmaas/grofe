-V
attach -d -t <session>:<window>
attach-session -t <session>
display-message 'Tmux environment saved!'
display-message 'Tmux resurrect file not found!'
display-message -c <client> -p '#{client_tty}\t#{session_name}\t#{window_id}\t#{pane_id}'
display-message -p #{client_tty}
display-message -p #{session_name}
display-message -p 'state\t#{client_session}\t#{client_last_session}'
display-message -p -t %N #{pane_pid}
display-message -p -t %N #{pane_start_command}
has-session -t =<session>
kill-pane -t %N
kill-session -t <session>
kill-window -t <session>:<window>
list-panes -a -F #{pane_pid}|#{pane_id}|#{@canopy_agent_source}|#{@canopy_agent_session}
list-panes -a -F '#{pane_id}\t#{session_name}\t#{window_id}\t#{window_index}\t#{pane_index}\t#{pane_active}\t#{pane_tty}\t#{pane_pid}\t#{pane_current_path}\t#{pane_current_command}\t#{pane_title}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_right}'
list-panes -a -F 'pane\t#{session_name}\t#{window_index}\t#{window_active}\t:#{window_flags}\t#{pane_index}\t#{pane_title}\t:#{pane_current_path}\t#{pane_active}\t#{pane_current_command}\t#{pane_pid}\t#{history_size}'
list-panes -a -f #{&&:#{window_active},#{!=:#{pane_title},opensessions-sidebar}} -F '#{session_name}\t#{pane_current_path}'
list-panes -s -t <name> -F '#{pane_id}\t#{session_name}\t#{window_id}\t#{window_index}\t#{pane_index}\t#{pane_active}\t#{pane_tty}\t#{pane_pid}\t#{pane_current_path}\t#{pane_current_command}\t#{pane_title}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_right}'
list-panes -t @N -F '#{pane_id}\t#{session_name}\t#{window_id}\t#{window_index}\t#{pane_index}\t#{pane_active}\t#{pane_tty}\t#{pane_pid}\t#{pane_current_path}\t#{pane_current_command}\t#{pane_title}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_right}'
list-sessions
list-sessions -F #{session_name}
list-sessions -F '#{session_grouped}\t#{session_group}\t#{session_id}\t#{session_name}'
list-sessions -F '#{session_id}\t#{session_name}\t#{session_created}\t#{session_attached}\t#{session_windows}\t#{session_path}'
list-windows -a -F '#{window_id}\t#{session_id}\t#{session_name}\t#{window_index}\t#{window_name}\t#{window_active}\t#{window_panes}'
list-windows -a -F 'window\t#{session_name}\t#{window_index}\t:#{window_name}\t#{window_active}\t:#{window_flags}\t#{window_layout}'
move-window -r -s <session>: -t <session>:
new -P -d -s <name> -n <name> -c <dir>
new-session -A -s <name> -d
new-session -d -s <name> -x 200 -y 50
neww -P -d -t <session>: -c <dir> -F #{window_id} -n <name>
resize-pane -t %N -x 26
select-layout -t @N main-vertical
select-layout -t @N tiled
select-pane -t %N -T opensessions-sidebar
set-option -g -q display-time 5000
set-option -g -q display-time 750
set-window-option -t @N remain-on-exit on
setenv -t <session> SMUG_SESSION <value>
setenv -t <session> SMUG_SESSION_CONFIG_PATH <value>
show -g -q -v @canopy_resume_stagger_ms
show -g -v @pill_l
show -g -v @pill_r
show -g -v @theme_bg
show -g -v @theme_blue
show -g -v command-alias
show-option -g -q -v @resurrect-capture-pane-contents
show-option -g -q -v @resurrect-delete-backup-after
show-option -g -q -v @resurrect-dir
show-option -g -q -v @resurrect-hook-post-save-all
show-option -g -q -v @resurrect-hook-post-save-layout
show-option -g -q -v @resurrect-restore-script-path
show-option -g -q -v @resurrect-save-command-strategy
show-option -g -q -v display-time
show-window-options -v -t <session>:1 automatic-rename
show-window-options -v -t <session>:2 automatic-rename
show-window-options -v -t <session>:3 automatic-rename
show-window-options -v -t <session>:4 automatic-rename
split-window -P -d -t @N -c <dir> -F #{pane_id}
split-window -h -b -f -l 26 -t %N -P -F '#{pane_id}\t#{session_name}\t#{window_id}\t#{window_index}\t#{pane_index}\t#{pane_active}\t#{pane_tty}\t#{pane_pid}\t#{pane_current_path}\t#{pane_current_command}\t#{pane_title}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_right}' 'OPENSESSIONS_SESSION_NAME=main OPENSESSIONS_WINDOW_ID=@N REFOCUS_WINDOW=@N exec "${OPENSESSIONS_DIR:-.}"/apps/tui/scripts/start.sh'
switch-client -c <client> -t <session>
