set-hook -g after-kill-pane 'run-shell "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{==:##{window_panes},1},##{==:##{pane_title},opensessions-sidebar}}'"'"' -F '"'"'##{session_name}\t##{pane_id}\t##{session_windows}'"'"' | while IFS=\$(printf '"'"'\\t'"'"') read -r session pane windows; do if [ \"\$windows\" -le 1 ]; then fallback=\$(tmux -S #{socket_path} list-sessions -F '"'"'##{session_name}'"'"' | awk -v s=\"\$session\" '"'"'\$0==s { if (prev != \"\") { print prev; exit }; seen=1; next } seen { print; exit } { prev=\$0 }'"'"'); tmux -S #{socket_path} list-clients -t \"=\$session:\" -F '"'"'##{client_tty}'"'"' | while IFS= read -r client; do [ -n \"\$client\" ] && [ -n \"\$fallback\" ] && tmux -S #{socket_path} switch-client -c \"\$client\" -t \"=\$fallback:\" >/dev/null 2>&1 || true; done; fi; tmux -S #{socket_path} kill-pane -t \"\$pane\" >/dev/null 2>&1 || true; done" ; run-shell "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/pane-exited >/dev/null 2>&1 || true" ; run-shell -b "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{>:##{window_panes},1},##{&&:##{==:##{pane_title},opensessions-sidebar},##{!=:##{pane_width},##{@opensessions_width}}}}'"'"' -F '"'"'##{pane_id}'"'"' | xargs -n1 -I{} tmux -S #{socket_path} resize-pane -t {} -x \$(tmux -S #{socket_path} show-option -gqv @opensessions_width)"'
set-hook -g after-new-window 'run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/ensure-sidebar -d '"'"'#{client_tty}|#{session_name}|#{window_id}|#{pane_id}|#{pane_active}'"'"' >/dev/null 2>&1 || true"'
set-hook -g after-resize-pane 'run-shell -b "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{>:##{window_panes},1},##{&&:##{==:##{pane_title},opensessions-sidebar},##{!=:##{pane_width},##{@opensessions_width}}}}'"'"' -F '"'"'##{pane_id}'"'"' | xargs -n1 -I{} tmux -S #{socket_path} resize-pane -t {} -x $(tmux -S #{socket_path} show-option -gqv @opensessions_width)"'
set-hook -g after-resize-window 'run-shell -b "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{>:##{window_panes},1},##{&&:##{==:##{pane_title},opensessions-sidebar},##{!=:##{pane_width},##{@opensessions_width}}}}'"'"' -F '"'"'##{pane_id}'"'"' | xargs -n1 -I{} tmux -S #{socket_path} resize-pane -t {} -x $(tmux -S #{socket_path} show-option -gqv @opensessions_width)" ; run-shell -b "sleep 0.05; curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/pane-layout-changed >/dev/null 2>&1 || true"'
set-hook -g after-select-pane 'run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/focus -d '"'"'#{client_tty}|#{session_name}|#{window_id}|#{pane_id}|#{pane_active}'"'"' >/dev/null 2>&1 || true"'
set-hook -g after-select-window 'run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/ensure-sidebar -d '"'"'#{client_tty}|#{session_name}|#{window_id}|#{pane_id}|#{pane_active}'"'"' >/dev/null 2>&1 || true"'
set-hook -g client-resized 'run-shell -b "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{>:##{window_panes},1},##{&&:##{==:##{pane_title},opensessions-sidebar},##{!=:##{pane_width},##{@opensessions_width}}}}'"'"' -F '"'"'##{pane_id}'"'"' | xargs -n1 -I{} tmux -S #{socket_path} resize-pane -t {} -x $(tmux -S #{socket_path} show-option -gqv @opensessions_width)" ; run-shell -b "sleep 0.05; curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/client-resized >/dev/null 2>&1 || true"'
set-hook -g client-session-changed 'run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/focus -d '"'"'#{client_tty}|#{session_name}|#{window_id}|#{pane_id}|#{pane_active}'"'"' >/dev/null 2>&1 || true" ; run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/ensure-sidebar -d '"'"'#{client_tty}|#{session_name}|#{window_id}|#{pane_id}|#{pane_active}'"'"' >/dev/null 2>&1 || true"'
set-hook -g pane-died 'run-shell "tmux -S #{socket_path} list-panes -a -F '"'"'##{session_name}\t##{window_id}\t##{pane_title}\t##{pane_dead}\t##{session_windows}'"'"' | awk -F '"'"'\t'"'"' '"'"'{ key=\$1 \"\\t\" \$2; session[key]=\$1; window[key]=\$2; windows[key]=\$5; if (\$3==\"opensessions-sidebar\") { sidebars[key]++ } else if (\$4!=\"1\") { live[key]++ } } END { for (key in session) if (sidebars[key] > 0 && live[key]+0 == 0) print session[key] \"\\t\" window[key] \"\\t\" windows[key] }'"'"' | while IFS=\$(printf '"'"'\\t'"'"') read -r session window windows; do if [ \"\$windows\" -le 1 ]; then fallback=\$(tmux -S #{socket_path} list-sessions -F '"'"'##{session_name}'"'"' | awk -v s=\"\$session\" '"'"'\$0==s { if (prev != \"\") { print prev; exit }; seen=1; next } seen { print; exit } { prev=\$0 }'"'"'); tmux -S #{socket_path} list-clients -t \"=\$session:\" -F '"'"'##{client_tty}'"'"' | while IFS= read -r client; do [ -n \"\$client\" ] && [ -n \"\$fallback\" ] && tmux -S #{socket_path} switch-client -c \"\$client\" -t \"=\$fallback:\" >/dev/null 2>&1 || true; done; fi; tmux -S #{socket_path} kill-window -t \"\$window\" >/dev/null 2>&1 || true; done; tmux -S #{socket_path} list-panes -a -f '"'"'##{==:##{pane_dead},1}'"'"' -F '"'"'##{pane_id}'"'"' | while IFS= read -r pane; do [ -n \"\$pane\" ] && tmux -S #{socket_path} kill-pane -t \"\$pane\" >/dev/null 2>&1 || true; done" ; run-shell "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/pane-exited >/dev/null 2>&1 || true" ; run-shell -b "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{>:##{window_panes},1},##{&&:##{==:##{pane_title},opensessions-sidebar},##{!=:##{pane_width},##{@opensessions_width}}}}'"'"' -F '"'"'##{pane_id}'"'"' | xargs -n1 -I{} tmux -S #{socket_path} resize-pane -t {} -x \$(tmux -S #{socket_path} show-option -gqv @opensessions_width)"'
set-hook -g pane-exited 'run-shell "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{==:##{window_panes},1},##{==:##{pane_title},opensessions-sidebar}}'"'"' -F '"'"'##{session_name}\t##{pane_id}\t##{session_windows}'"'"' | while IFS=\$(printf '"'"'\\t'"'"') read -r session pane windows; do if [ \"\$windows\" -le 1 ]; then fallback=\$(tmux -S #{socket_path} list-sessions -F '"'"'##{session_name}'"'"' | awk -v s=\"\$session\" '"'"'\$0==s { if (prev != \"\") { print prev; exit }; seen=1; next } seen { print; exit } { prev=\$0 }'"'"'); tmux -S #{socket_path} list-clients -t \"=\$session:\" -F '"'"'##{client_tty}'"'"' | while IFS= read -r client; do [ -n \"\$client\" ] && [ -n \"\$fallback\" ] && tmux -S #{socket_path} switch-client -c \"\$client\" -t \"=\$fallback:\" >/dev/null 2>&1 || true; done; fi; tmux -S #{socket_path} kill-pane -t \"\$pane\" >/dev/null 2>&1 || true; done" ; run-shell "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/pane-exited >/dev/null 2>&1 || true" ; run-shell -b "tmux -S #{socket_path} list-panes -a -f '"'"'##{&&:##{>:##{window_panes},1},##{&&:##{==:##{pane_title},opensessions-sidebar},##{!=:##{pane_width},##{@opensessions_width}}}}'"'"' -F '"'"'##{pane_id}'"'"' | xargs -n1 -I{} tmux -S #{socket_path} resize-pane -t {} -x \$(tmux -S #{socket_path} show-option -gqv @opensessions_width)"'
set-hook -g session-closed 'run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/refresh >/dev/null 2>&1 || true"'
set-hook -g session-created 'run-shell -b "curl -s -o /dev/null -m 0.2 --connect-timeout 0.1 -X POST http://127.0.0.1:24770/refresh >/dev/null 2>&1 || true"'
