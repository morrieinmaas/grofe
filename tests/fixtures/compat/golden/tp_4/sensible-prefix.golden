bind-key -T prefix R run-shell " \t\t\ttmux source-file <TMPDIR>/home/.tmux.conf > /dev/null; \t\t\ttmux display-message 'Sourced <TMPDIR>/home/.tmux.conf!'"
bind-key -T prefix a last-window
bind-key -T prefix C-a send-prefix
bind-key -T prefix C-n next-window
bind-key -T prefix C-p previous-window
