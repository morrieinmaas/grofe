# TC.7 (M36-R5): which-key's -x R -y P, fired without the mouse: the menu's
# right edge on the current pane's, its bottom on the pane's bottom.
$ new-session -d -s main -n first -x 60 -y 15 cat
$ source-file {fixtures}/tmux-status-noclock.conf
$ split-window -h -l 25 -t main cat
$ select-pane -t main:1.1
client 60x15 attach -t main
$& display-menu -c {client} -T Keys -x R -y P Split s "split-window" Kill x "kill-pane"
screen Split
