# B2b: C-s and C-r open an incremental prompt; every key searches again from where the prompt began, C-s and C-r step to the next or previous match, BSpace backs up, Enter keeps the position.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/../copy/fixture.txt; tmux wait-for -S ready; exec sleep 100000'
$ wait-for ready
$ set-window-option -g mode-keys emacs
$ set-option -g status off
client 80x24 attach -t main
$ copy-mode -H -t main
$ display -p -t main '#{pane_in_mode} #{copy_cursor_x},#{copy_cursor_y},#{scroll_position} sel=#{selection_present} search=#{search_present},#{search_count},#{search_match}'
keys Escape <
$ display -p -t main '#{pane_in_mode} #{copy_cursor_x},#{copy_cursor_y},#{scroll_position} sel=#{selection_present} search=#{search_present},#{search_count},#{search_match}'
keys C-s
$ display -p -t main '#{pane_in_mode} #{copy_cursor_x},#{copy_cursor_y},#{scroll_position} sel=#{selection_present} search=#{search_present},#{search_count},#{search_match}'
