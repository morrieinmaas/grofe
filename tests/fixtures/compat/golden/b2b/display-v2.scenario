# B2b: display-message -v through more of the format language: boolean operators, matches, basename, padding, length, expressions, expanded variables and the window loop.
$ new-session -d -s main -x 80 -y 24 -c /tmp cat
$ set-option -g @opt 'a b'
$ set-option -g @fmt '#{session_name}-#{window_index}'
$ display-message -p -v '#{&&:#{pane_active},#{window_active}}'
$ display-message -p -v '#{||:0,1,0}'
$ display-message -p -v '#{!:#{pane_active}}'
$ display-message -p -v '#{!!:#{pane_active}}'
$ display-message -p -v '#{m:ma*,#{session_name}}'
$ display-message -p -v '#{m/r:^m.i,#{session_name}}'
$ display-message -p -v '#{b:pane_current_path}'
$ display-message -p -v '#{p8:session_name}|'
$ display-message -p -v '#{n:session_name}'
$ display-message -p -v '#{w:session_name}'
$ display-message -p -v '#{e|+:1,2}'
$ display-message -p -v '#{E:@fmt}'
$ display-message -p -v '#{T:@fmt}'
$ display-message -p -v '#{@opt}'
$ display-message -p -v '#{q:@opt}'
$ display-message -p -v '#{?pane_active,#{?window_active,both,pane},none}'
$ display-message -p -v '#{W:#{window_index} }'
$ display-message -p -v '#{=3:#{session_name}}'
$ display-message -p -v '#{=/-2/~:session_name}'
$ display-message -p -v '#{s/a/X/g:session_name}'
$ display-message -p -v '#{t:session_created}' 
$ display-message -p -v '#{>=:#{window_index},1}'
$ display-message -p -v '#{!=:a,b}'
$ display-message -p -v '#{<:9,10}'
