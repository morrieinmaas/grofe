# B2b: display-message -v prints how each format expanded, one line per step, each nested level one space further in; -l prints the message as it is; -p with neither expands as always.
$ new-session -d -s main -x 80 -y 24 cat
$ display-message -p -v 'hello'
$ display-message -p -v ''
$ display-message -p -v '#{session_name}'
$ display-message -p -v '##'
$ display-message -p -v 'a#{session_name}b#{window_index}c'
$ display-message -p -v '#{nosuchvar}'
$ display-message -p -v '#{?pane_active,yes,no}'
$ display-message -p -v '#{?nosuch,yes,no}'
$ display-message -p -v '#{==:#{session_name},main}'
$ display-message -p -v '#{window_index}#{?window_zoomed_flag, Z,}'
$ display-message -p -v '#{s/a/b/:session_name}'
$ display-message -p -v '#{=2:session_name}'
$ display-message -p -v '#{@x}'
$ display-message -p -v -F '#{session_name}'
$ display-message -pl '#{session_name} #S ##'
$ display-message -p -l '#{session_name}'
$ display-message -lv -p '#{session_name}'
$ display-message -p 'literal'
$ display-message -l 'not printed'
$ display-message -p -v -t main:1.1 '#{pane_index}'
