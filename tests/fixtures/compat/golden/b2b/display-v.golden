#  found #{}: session_name
#  format 'session_name' found: main
#  replaced 'session_name' with 'main'
#  result is: main
#  expanding format: main
#  result is: main
# compare == left is: main
# compare == right is: main
# replaced '==:#{session_name},main' with '1'
# result is: 1
1
