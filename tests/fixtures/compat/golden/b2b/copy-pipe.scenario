# B2b: pipe, pipe-no-clear and pipe-and-cancel send the selection to a shell command without storing it in a buffer: pipe clears the selection, pipe-no-clear keeps it, pipe-and-cancel leaves copy mode. The command is a format; with none, copy-command runs; an empty selection still runs it; a flag or a second word makes tmux ignore the command.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/../copy/fixture.txt; tmux wait-for -S ready; exec sleep 100000'
$ wait-for ready
$ copy-mode -t main
$ send-keys -t main -X history-top
$ send-keys -t main -X select-line
$ send-keys -t main -X pipe 'cat > "$HOME/p1"'
$ display -p -t main '#{pane_in_mode} sel=#{selection_present}'
$ send-keys -t main -X cursor-down
$ send-keys -t main -X select-line
$ send-keys -t main -X pipe-no-clear 'cat > "$HOME/p2.#{pane_index}"'
$ display -p -t main '#{pane_in_mode} sel=#{selection_present}'
$ send-keys -t main -X pipe-and-cancel 'cat > "$HOME/p3"'
$ display -p -t main '#{pane_in_mode} sel=#{selection_present}'
$ run-shell 'sleep 1; for f in p1 p2.1 p3; do echo "== $f"; cat "$HOME/$f"; done'
$ list-buffers -F '#{buffer_name} #{buffer_size}'
$ copy-mode -t main
$ send-keys -t main -X history-top
$ send-keys -t main -X pipe 'cat > "$HOME/p4"'
$ send-keys -t main -X pipe-no-clear 'cat > "$HOME/p5"'
$ send-keys -t main -X pipe-and-cancel 'cat > "$HOME/p6"'
$ display -p -t main '#{pane_in_mode}'
$ run-shell 'sleep 1; for f in p4 p5 p6; do echo "== $f"; wc -c < "$HOME/$f" | tr -d " "; done'
$ set-option -g copy-command 'cat > "$HOME/cc"'
$ copy-mode -t main
$ send-keys -t main -X history-top
$ send-keys -t main -X begin-selection
$ send-keys -t main -X -N 5 cursor-right
$ send-keys -t main -X pipe
$ run-shell 'sleep 1; echo "cc:"; cat "$HOME/cc"; rm "$HOME/cc"'
$ send-keys -t main -X begin-selection
$ send-keys -t main -X -N 3 cursor-right
$ send-keys -t main -X pipe ''
$ run-shell 'sleep 1; echo "cc2:"; cat "$HOME/cc"; rm "$HOME/cc"'
$ send-keys -t main -X begin-selection
$ send-keys -t main -X -N 3 cursor-right
$ send-keys -t main -X pipe-no-clear 'cat > "$HOME/p7"'
$ run-shell 'sleep 1; echo "p7:"; cat "$HOME/p7"; [ -e "$HOME/cc" ] && echo cc exists || echo no cc'
$ send-keys -t main -X pipe -C 'cat > "$HOME/p8"'
$ send-keys -t main -X pipe 'cat > "$HOME/p9"' extra
$ send-keys -t main -X pipe -- 'cat > "$HOME/p10"'
$ display -p -t main '#{pane_in_mode} sel=#{selection_present}'
$ run-shell 'sleep 1; for f in p8 p9 p10; do [ -e "$HOME/$f" ] && echo "$f yes" || echo "$f no"; done'
$ send-keys -t main -X pipe-and-cancel
$ display -p -t main '#{pane_in_mode}'
$ run-shell 'sleep 1; echo "cc3:"; cat "$HOME/cc"; rm "$HOME/cc"'
