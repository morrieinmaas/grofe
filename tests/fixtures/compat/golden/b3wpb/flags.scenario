# B3 WP-B: the flags tmux has and grofe refused: select-window -n -p -l -T, last-pane -Z -d -e, send-keys -R and -K -c with no client to type on.
$ new-session -d -s main -x 40 -y 12 'sleep 100000'
$ new-window -d -t main:5 'sleep 100000'
$ new-window -d -t main:7 'sleep 100000'
$ select-window -n -t main
$ display-message -p -t main '#{window_index}'
