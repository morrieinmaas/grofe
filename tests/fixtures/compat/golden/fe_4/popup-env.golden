$ new-session -d -s main -x 80 -y 24 cat
? 0
$ set -g status off
? 0
client 80x24 attach -t main
$ display-popup -E 'env | grep -v "^_=" | sort > "$HOME/popup-env"'
? 0
$ run-shell 'cat "$HOME/popup-env"'
COLORTERM=truecolor
HOME=<TMPDIR>/home
LANG=C.UTF-8
PATH=/usr/local/bin:/usr/bin:/bin
PWD=<TMPDIR>/home
SHELL=/bin/sh
TERM=tmux-256color
TERM_PROGRAM=tmux
TERM_PROGRAM_VERSION=3.7b
TMUX=<SOCKET>,<PID>,0
TMUX_TMPDIR=<TMPDIR>
? 0
