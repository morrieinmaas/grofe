# FE.4 case 3: env inside a genuine popup (display-popup, not fzf's
# new-pane): TMUX is set and TMUX_PANE is not. The popup writes its env to
# a file; run-shell prints it once the popup has closed.
$ new-session -d -s main -x 80 -y 24 cat
$ set -g status off
client 80x24 attach -t main
$ display-popup -E 'env | grep -v "^_=" | sort > "$HOME/popup-env"'
$ run-shell 'cat "$HOME/popup-env"'
