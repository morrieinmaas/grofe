# FE.4 case 2 (M36-R1): fzf 0.74's --tmux calls, argv for argv, with a
# shell script in fzf's place: the capability probe, the zoom check and
# new-pane in one request, the script's own set-option -p calls against
# $TMUX_PANE, then wait-for until the pane signals. The result reaches the
# caller through the file the pane wrote, as fzf's own does.
$ new-session -d -s main -x 160 -y 40 cat
$ display-message -p -t main:1.1 '#{window_width} #{window_height}' \; list-commands new-pane
$ if -F -t main:1.1 '#{window_zoomed_flag}' 'resize-pane -Z -t main:1.1' \; new-pane -P -F '#{pane_id}' -t main:1.1 -c /tmp -x 60 -y 12 -X 20 -Y 5 sh -c 'tmux set-option -p -t "$TMUX_PANE" remain-on-exit off 2> /dev/null; tmux set-option -p -t "$TMUX_PANE" @fzf-border-label " pick " 2> /dev/null; tmux set-option -p -t "$TMUX_PANE" pane-border-format "#{@fzf-border-label}" 2> /dev/null; echo picked-b > "$HOME/fzf-out"; echo 0 > "$HOME/fzf-out.code"; tmux wait-for -S fzf-done'
$ wait-for fzf-done
$ run-shell 'cat "$HOME/fzf-out" "$HOME/fzf-out.code"'
$ list-panes -t main -F '#{pane_id} #{pane_floating_flag}'
