# WP-A: the command prompt draws in message-style (command mode of
# status-keys vi in message-command-style, unit-tested: tmux holds a lone
# Escape back in the recorder), Tab completes command names
# (to what the candidates share), M-b moves by words, several -p prompts
# each have a label and an initial text, 
$ new-session -d -s main -n first -x 60 -y 12 cat
$ set -g status off
client 60x12 attach -t main
keys C-b :
screen :
styles 11-11 :
keys spli Tab
screen :split
keys C-c
$ set -g message-style 'bg=blue,fg=white,fill=blue'
keys C-b :
keys abc Space def
keys M-b M-b X
screen :Xabc def
styles 11-11 :Xabc
keys C-c
$ bind-key q command-prompt -p 'first,second' -I 'x,y' 'display-message -p "%1-%2"'
keys C-b q
screen first x
keys z Enter
screen second y
keys Enter
screen xz-y
keys q
