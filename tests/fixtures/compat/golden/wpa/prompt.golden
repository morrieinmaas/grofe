$ new-session -d -s main -n first -x 60 -y 12 cat
? 0
$ set -g status off
? 0
client 60x12 attach -t main
keys C-b :
screen :
|
|
|
|
|
|
|
|
|
|
|
| :
styles 11-11 :
~ 11 0-0 fg=black bg=yellow
~ 11 1-59 fg=default bg=yellow
keys spli Tab
screen :split
|
|
|
|
|
|
|
|
|
|
|
| :split
keys C-c
$ set -g message-style 'bg=blue,fg=white,fill=blue'
? 0
keys C-b :
keys abc Space def
keys M-b M-b X
screen :Xabc def
|
|
|
|
|
|
|
|
|
|
|
| :Xabc def
styles 11-11 :Xabc
~ 11 0-4 fg=white bg=blue
~ 11 5-5 fg=default bg=blue
~ 11 6-8 fg=white bg=blue
~ 11 9-59 fg=default bg=blue
keys C-c
$ bind-key q command-prompt -p 'first,second' -I 'x,y' 'display-message -p "%1-%2"'
? 0
keys C-b q
screen first x
|
|
|
|
|
|
|
|
|
|
|
| first x
keys z Enter
screen second y
|
|
|
|
|
|
|
|
|
|
|
| second y
keys Enter
screen xz-y
| xz-y                                                   [0/0]
