$ new-session -d -s main -n one -x 70 -y 30 cat
? 0
$ set -g status off
? 0
$ bind-key C customize-mode -Z -f '#{||:#{m:status-left-length,#{option_name}},#{is_key}}'
? 0
$ bind-key -T mytab F5 display-message five
? 0
$ bind-key -T mytab F6 display-message six
? 0
$ bind-key C-z display-message zz
? 0
client 70x30 attach -t main
keys C-b C
$ run-shell 'sleep 0.5'
