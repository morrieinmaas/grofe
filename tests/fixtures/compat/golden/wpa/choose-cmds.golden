? 0
client 70x30 attach -t main
$ bind-key j choose-tree -w -F '#{?pane_format,pane #{pane_index},#{?window_format,win #{window_name}#{window_flags},#{session_windows} wins}}' "rename-window -t '%%' picked"
? 0
keys C-b j
$ run-shell 'sleep 0.5'
