$ new-session -d -s main -n one -x 70 -y 30 cat
? 0
$ set -g status off
? 0
$ bind-key C customize-mode -Z -f '#{||:#{m:status-*,#{option_name}},#{is_key}}'
? 0
$ bind-key -T mytab -N 'a note' x display-message hi
? 0
