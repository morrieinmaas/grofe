# G3: ED 2 frees the image: its text goes with it.
# Recorded with the container's sixel-enabled tmux (`tmux-sixel`); `-q` makes
# real tmux ignore `graphics`, grofe's option for it.
$ new-session -d -s main -x 40 -y 12 "stty -echo; read go; sh {fixtures}/g3-sixel.sh clear"
$ set -g -q graphics on
$ set -g status off
client 40x12 attach -t main
$ send-keys -t main Enter
screen drawn
screen cleared
