$ new-session -d -s main -n first -x 60 -y 15 cat
? 0
$ source-file {fixtures}/tmux-status-noclock.conf
? 0
$ set -g status-right ''
? 0
client 60x15 attach -t main
$& display-menu -c {client} -x 10 -y 10 -T Menu Alpha a 'set -g @r alpha' '' Beta b 'set -g @r beta'
styles 3-7 Menu
~ 6 11-11 fg=default bg=yellow
~ 6 12-16 fg=black bg=yellow
~ 6 17-17 fg=default bg=yellow
~ 6 18-20 fg=black bg=yellow
~ 6 21-21 fg=default bg=yellow
keys q
$ set -g menu-style 'fg=green,bg=black'
? 0
$ set -g menu-selected-style 'fg=white,bg=red,bold'
? 0
$ set -g menu-border-style 'fg=cyan'
