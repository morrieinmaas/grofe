$ new-session -d -s main -n first -x 60 -y 15 cat
? 0
$ source-file {fixtures}/tmux-status-noclock.conf
? 0
$ set -g status-right ''
? 0
client 60x15 attach -t main
$& display-popup -c {client} -w 20 -h 5 -x 5 -y 8 -T Title 'echo hi; sleep 30'
styles 3-7 Title
keys C-c
$ set -g popup-style 'bg=blue'
? 0
$ set -g popup-border-style 'fg=red'
? 0
$& display-popup -c {client} -w 20 -h 5 -x 5 -y 8 -T Title 'echo hi; sleep 30'
styles 3-7 Title
~ 3 5-24 fg=red bg=default
~ 4 5-5 fg=red bg=default
~ 4 6-23 fg=default bg=blue
~ 4 24-24 fg=red bg=default
~ 5 5-5 fg=red bg=default
~ 5 6-23 fg=default bg=blue
~ 5 24-24 fg=red bg=default
~ 6 5-5 fg=red bg=default
~ 6 6-23 fg=default bg=blue
~ 6 24-24 fg=red bg=default
~ 7 5-24 fg=red bg=default
keys C-c
$& display-popup -c {client} -w 20 -h 5 -x 5 -y 8 -s 'fg=yellow,bold' -S 'fg=green,bg=magenta' -T Title 'echo hi; sleep 30'
styles 3-7 Title
~ 3 5-24 fg=green bg=magenta
~ 4 5-5 fg=green bg=magenta
~ 4 6-7 fg=yellow bg=default
~ 4 24-24 fg=green bg=magenta
~ 5 5-5 fg=green bg=magenta
~ 5 24-24 fg=green bg=magenta
~ 6 5-5 fg=green bg=magenta
~ 6 24-24 fg=green bg=magenta
~ 7 5-24 fg=green bg=magenta
keys C-c
$ set -g popup-style default
? 0
$ set -g popup-border-style default
? 0
