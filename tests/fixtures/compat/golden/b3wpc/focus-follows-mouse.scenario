# B3 WP-C: focus-follows-mouse. The left pane is columns 0..33, the border
# column 34, the right pane columns 35..59 of rows 0..13.
$ new-session -d -s main -n first -x 60 -y 15 cat
$ source-file {fixtures}/tmux-status-noclock.conf
$ set -g status-right ''
$ split-window -h -l 25 -t main cat
$ select-pane -t main:1.1
client 60x15 attach -t main
$ display-message -p -t main '#{pane_id}'
# Off by default: motion over the other pane does nothing.
keys Escape '[<35;50;5M'
$ display-message -p -t main '#{pane_id}'
$ set -g focus-follows-mouse on
keys Escape '[<35;50;5M'
$ display-message -p -t main '#{pane_id}'
keys Escape '[<35;10;5M'
$ display-message -p -t main '#{pane_id}'
# Over the border or the status line: nothing.
keys Escape '[<35;35;5M'
keys Escape '[<35;50;15M'
$ display-message -p -t main '#{pane_id}'
keys Escape '[<35;50;5M'
$ display-message -p -t main '#{pane_id}'
keys Escape '[<35;50;15M'
$ display-message -p -t main '#{pane_id}'
# A press still focuses, with it off.
$ set -g focus-follows-mouse off
keys Escape '[<35;10;5M'
$ display-message -p -t main '#{pane_id}'
keys Escape '[<0;10;5M'
keys Escape '[<0;10;5m'
$ display-message -p -t main '#{pane_id}'
$ set -g focus-follows-mouse on
$ set -g mouse off
keys Escape '[<35;50;5M'
$ display-message -p -t main '#{pane_id}'
$ set -g mouse on
# A MouseMovePane binding fires.
$ bind -n MouseMovePane set -g @moved '#{pane_id}'
keys Escape '[<35;40;5M'
$ show -gv @moved
$ display-message -p -t main '#{pane_id}'
