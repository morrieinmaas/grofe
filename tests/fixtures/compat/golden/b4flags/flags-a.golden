$ show-options -gH after-new-window
after-new-window[0] set-option -g @hooked yes
? 0
$ show-options -g -H
@gopt gval
activity-action other
assume-paste-time 1
base-index 1
bell-action any
default-command ''
default-shell /bin/sh
default-size 80x24
destroy-unattached off
detach-on-destroy on
display-panes-active-colour red
display-panes-colour blue
display-panes-time 1000
display-time 750
focus-follows-mouse off
history-limit 50000
initial-repeat-time 0
key-table root
lock-after-time 0
lock-command "lock -np"
message-command-style bg=black,fg=yellow,fill=black
message-format "#[#{?#{command_prompt},#{E:message-command-style},#{E:message-style}}]#{message}"
message-line 0
message-style bg=yellow,fg=black,fill=yellow
mouse on
prefix C-b
prefix2 None
renumber-windows on
