# B1d: menu and popup positions at the screen edges: clamped inside the
# client, negative and huge values, a menu wider than the client opens
# nothing, and a two-line status line with W and S.
$ new-session -d -s main -n one -x 30 -y 10 cat
$ new-window -d -t main:2 -n second cat
$ set -g status-right ''
client 30x10 attach -t main
$& display-menu -x 28 -y 9 -T Corner A a 'display a' B b 'display b'
screen Corner
keys q
$& display-menu -x -5 -y -5 -T Negative A a 'display a'
screen Negative
keys q
$& display-menu -x 1000 -y 1000 -T Huge A a 'display a'
screen Huge
keys q
$& display-menu -T Wide 'a label far wider than the thirty cell client can ever hold' a 'display a'
screen Wide
keys q
$& display-popup -E -x 28 -y 9 -w 10 -h 4 'echo in-popup; exec cat'
screen in-popup
keys C-d
$ set -g status 2
$ set -g status-format[1] ''
$& display-menu -x W -y W -T Two A a 'display a'
screen Two
keys q
$& display-menu -x W -y S -T TwoS A a 'display a'
screen TwoS
keys q
$ set -g status-position top
$& display-menu -x W -y W -T TwoTop A a 'display a'
screen TwoTop
keys q
$& display-menu -x W -y S -T TwoTopS A a 'display a'
screen TwoTopS
keys q
