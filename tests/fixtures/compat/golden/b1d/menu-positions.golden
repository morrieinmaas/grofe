$ new-session -d -s main -n one -x 80 -y 24 cat
? 0
$ new-window -d -t main:2 -n second cat
? 0
$ new-window -d -t main:3 -n third cat
? 0
$ split-window -h -d -t main:1 cat
? 0
$ set -g status-right ''
? 0
client 80x24 attach -t main
$& display-menu -x W -y W -T MenuWin A a 'display a' B b 'display b'
screen MenuWin
