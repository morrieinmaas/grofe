# FE.2: the structure verbs through the tmux front end, each checked by
# its list-panes -a -F and the window's layout string.
$ new-session -d -s main -x 200 -y 50
$ split-window -h -t main
$ split-window -v -t main
$ split-window -h -t main:1.1
$ new-window -t main
$ split-window -v -t main:2
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
# join-pane: a pane of window 2 next to one of window 1.
$ join-pane -h -s main:2.2 -t main:1.3
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ display -p -t main:1 '#{window_layout}'
# swap-pane, by target and by direction.
$ swap-pane -s main:1.1 -t main:1.4
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ swap-pane -D -t main:1.2
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ display -p -t main:1 '#{window_layout}'
# swap-window, then back.
$ swap-window -s main:1 -t main:2
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ swap-window -s main:2 -t main:1
# rotate-window, both ways.
$ rotate-window -t main:1
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ rotate-window -D -t main:1
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ display -p -t main:1 '#{window_layout}'
# break-pane into its own window, then move-window.
$ break-pane -d -s main:1.2
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ display -p -t main:1 '#{window_layout}'
$ move-window -s main:3 -t main:7
$ list-windows -a -F '#{session_name}:#{window_index} #{window_panes} #{window_layout}'
# select-layout -E spreads the pane's cells evenly.
$ select-layout -E -t main:1.1
$ list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} #{pane_active}'
$ display -p -t main:1 '#{window_layout}'
