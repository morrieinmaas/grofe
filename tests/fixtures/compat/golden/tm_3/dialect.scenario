# TM.3: the regex dialect. Each pattern is searched forward from the top
# of history and backward from the bottom: POSIX extended syntax as
# glibc reads it (\d is a plain d, a backslash in brackets is itself),
# word boundaries, classes, intervals and anchors, and patterns glibc
# refuses, which find nothing.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/golden/tm_3/search.txt; exec sleep 100000'
$ run-shell 'sleep 1'
$ copy-mode -t main
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '\d'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '\d'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward 'd\d'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward 'd\d'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '\D'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '\D'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '[[:digit:]]+'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '[[:digit:]]+'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '[\d]+'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
