# TM.3: a regex search for fo+[0-9] from the top of history, each match in
# order, then n past the last match with wrap-search off (the cursor
# stays) and on (back to the first), N, and search-backward. A pattern
# with no upper-case letter ignores case. The readout is the cursor,
# then search_present, search_count and search_match.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/golden/tm_3/search.txt; exec sleep 100000'
$ run-shell 'sleep 1'
$ copy-mode -t main
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-forward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ set -g wrap-search off
$ send-keys -t main -X search-again
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-again
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ set -g wrap-search on
$ send-keys -t main -X search-again
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-again
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-reverse
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-reverse
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-reverse
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ set -g wrap-search off
$ send-keys -t main -X search-reverse
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-reverse
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-backward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-backward 'fo+[0-9]'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-again
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X search-reverse
