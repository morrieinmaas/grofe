# TM.3: classes and case outside ASCII, as glibc reads them in C.UTF-8:
# each pattern searched forward from the top and backward from the
# bottom of unicode.txt.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/golden/tm_3/unicode.txt; exec sleep 100000'
$ run-shell 'sleep 1'
$ copy-mode -t main
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '\w+é'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '\w+é'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '[[:alpha:]]+é'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '[[:alpha:]]+é'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '[[:upper:]][[:lower:]]+'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '[[:upper:]][[:lower:]]+'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '[[:lower:]]+ß'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
$ send-keys -t main -X search-backward '[[:lower:]]+ß'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-top
$ send-keys -t main -X search-forward '[[:digit:]]+'
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position} #{search_present} #{search_count} #{search_match}'
$ send-keys -t main -X history-bottom
