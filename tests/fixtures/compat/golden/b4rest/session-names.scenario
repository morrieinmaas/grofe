# B4 rest: session names with ':' or '.' (session_check_name).
$ new-session -d -s 'a:b' -x 40 -y 10 cat
$ list-sessions -F '[#{session_name}]'
$ new-session -d -s 'c.d' -x 40 -y 10 cat
$ new-session -d -s ':.:' -x 40 -y 10 cat
$ new-session -d -s ' lead' -x 40 -y 10 cat
$ new-session -d -s 'trail ' -x 40 -y 10 cat
$ new-session -d -s '$7' -x 40 -y 10 cat
$ new-session -d -s '' -x 40 -y 10 cat
$ new-session -d -s '=x' -x 40 -y 10 cat
$ new-session -d -s 'tab	x' -x 40 -y 10 cat
$ new-session -d -s 'é1' -x 40 -y 10 cat
$ list-sessions -F '[#{session_name}]'
$ rename-session -t 'a_b' 'e:f'
$ rename-session -t 'e_f' 'g.h'
$ rename-session -t 'g_h' ''
$ list-sessions -F '[#{session_name}]'
$ has-session -t 'a:b'
$ has-session -t 'e_f'
$ new-session -d -s 'e_f' -n w0 -x 40 -y 10 cat
$ new-session -d -s 'e:f' -x 40 -y 10 cat
$ new-window -t 'e_f:' -n 'w:1.x'
$ list-windows -t 'e_f' -F '[#{window_name}]'
$ rename-window -t 'e_f:1' 'p:q.r'
$ list-windows -t 'e_f' -F '[#{window_name}]'
