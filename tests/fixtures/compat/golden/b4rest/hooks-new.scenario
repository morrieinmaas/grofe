# B4 rest: pane-mode-changed fires when a pane enters or leaves a mode
# (copy mode, the clock, a chooser, a view mode), once for each.
$ new-session -d -s main -x 60 -y 10 cat
$ source-file {fixtures}/tmux-status-noclock.conf
$ set -g @log ''
$ set-hook -g pane-mode-changed 'set -gF @log "#{@log}M[#{pane_mode}]#{pane_id};"'
$ copy-mode
$ show -gv @log
$ copy-mode -q
$ show -gv @log
$ clock-mode
$ show -gv @log
$ clock-mode
$ show -gv @log
$ copy-mode -q
$ show -gv @log
$ set -g @log ''
client 60x10 attach -t main
$ choose-tree
$ show -gv @log
$ copy-mode -q
$ show -gv @log
$ set -g @log ''
keys C-b '['
$ show -gv @log
keys q
$ show -gv @log
$ set -g @log ''
keys C-b t
$ show -gv @log
keys x
$ show -gv @log
