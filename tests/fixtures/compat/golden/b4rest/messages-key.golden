$ new-session -d -s main -x 40 -y 10 cat
? 0
$ set -g message-limit 100
? 0
$ bind -n F5 set -g @x 1 \; display-message -p hi
hi
? 0
$ bind -n F6 run-shell 'true'
? 0
$ bind -n F7 if-shell -F 1 'set -g @y 2' 'set -g @y 3'
? 0
$ bind -n F8 command-prompt -p 'x:' 'set -g @p %%'
? 0
$ bind -n F9 confirm-before -p 'ok?' 'set -g @c yes'
? 0
$ bind -n F10 display-menu Item i 'set -g @m yes'
? 0
client 40x10 attach -t main
keys Escape '[15~'
keys Escape '[17~'
keys Escape '[18~'
$ run-shell 'sleep 0.3'
? 0
keys Escape '[19~'
keys z Enter
keys Escape '[20~'
keys y
keys Escape '[21~'
keys i
$ run-shell 'sleep 0.3'
? 0
$ run-shell "tmux show-messages | grep -E '^[^ ]+ [^ ]+ key F' | sed 's/^[^ ]* //'"
<TTY> key F10: set-option -g @m yes
<TTY> key F10: display-menu Item i "set -g @m yes"
<TTY> key F9: set-option -g @c yes
<TTY> key F9: confirm-before -p ok? "set -g @c yes"
<TTY> key F8: set-option -g @p z
<TTY> key F8: command-prompt -p x: "set -g @p %%"
<TTY> key F7: set-option -g @y 2
<TTY> key F7: if-shell -F 1 "set -g @y 2" "set -g @y 3"
<TTY> key F6: run-shell true
<TTY> key F5: set-option -g @x 1
? 0
