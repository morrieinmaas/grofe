# B4 rest: the escapes of a tmux config file's words (cmd-parse.y's
# cmd_parse_escape and environment expansion), each word in a file of its
# own so one refusal does not hide the rest.
$ new-session -d -s main -x 60 -y 10 cat
$ run-shell 'cp -r {fixtures}/b4rest-esc ~/esc'
$ source-file esc/env.conf
$ set-environment -g FOO bar
$ source-file esc/e01.conf
$ run-shell "tmux show-options -gv @e1 2>&1 | od -An -c"
$ source-file esc/e02.conf
$ run-shell "tmux show-options -gv @e2 2>&1 | od -An -c"
