$ new-session -d -s main -x 80 -y 10 cat
? 0
$ unbind -a -T prefix
? 0
$ unbind -a -T root
? 0
$ bind -T longtablename C-a send a
? 0
$ bind -T longtablename M-C-Left send b
? 0
$ bind -T longtablename -r BTab send c
? 0
$ bind -T longtablename MouseDown1StatusLeft send d
? 0
$ bind -T longtablename 'é' send e
? 0
$ bind -T longtablename F12 send f
? 0
$ bind -T short x send g
? 0
$ bind -T short -N 'a note here' y send h
? 0
$ bind -T short -N 'another longer note' -r Home send i
? 0
$ bind -n F5 send j
? 0
$ bind -n -N 'root note' F6 send k
? 0
$ bind C-x send l
? 0
$ bind -N 'prefix note' z send m
? 0
$ list-keys
bind-key    -T copy-mode     Escape               send-keys -X cancel
bind-key    -T copy-mode     Space                send-keys -X page-down
