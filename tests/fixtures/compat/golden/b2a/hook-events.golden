$ run-shell 'cat $HOME/h.log'
== rename-session
session-renamed sn=renamed s= wn= p= c= ctx=renamed:1.1
== rename-window
window-renamed sn= s= w=@1 wn=two p= c= ctx=main:2.1
== select-pane
window-pane-changed sn= s= w=@0 wn=first p= c= ctx=main:1.2
== select-window
session-window-changed sn=main s=sh w= wn= p= c= ctx=main:2.1
== split-window
window-layout-changed sn= s= w=@0 wn=first p= c= ctx=main:1.2
== new-window
window-linked sn=main s=sh w=@3 wn=third p= c=
== link-window
window-linked sn=renamed s= w=@3 wn=third p= c=
== unlink-window
window-unlinked sn=renamed s= w=@3 wn=third p= c=
== kill-window
window-unlinked sn=main s=sh w=@3 wn=third p= c=
== resize-window
window-layout-changed sn= s= w=@0 wn=first p= c= ctx=main:1.2
window-resized sn= s= w=@0 wn=first p= c= ctx=main:1.2
== select-pane-title
pane-title-changed sn= s= w=@0 wn=first p=%0 c= ctx=main:1.1
== attach
pane-focus-in sn= s= w=@1 wn=two p=%2 c= ctx=main:2.1
client-attached sn= s= w= wn= p= c=<TTY> ctx=main:2.1
window-layout-changed sn= s= w=@1 wn=two p= c= ctx=main:2.1
window-resized sn= s= w=@1 wn=two p= c= ctx=main:2.1
== split-attached
window-layout-changed sn= s= w=@1 wn=two p= c= ctx=main:2.1
== select-pane-attached
pane-focus-out sn= s= w=@1 wn=two p=%2 c= ctx=main:2.1
pane-focus-in sn= s= w=@1 wn=two p=%6 c= ctx=main:2.2
window-pane-changed sn= s= w=@1 wn=two p= c= ctx=main:2.2
== select-window-attached
pane-focus-out sn= s= w=@1 wn=two p=%6 c= ctx=main:2.2
pane-focus-in sn= s= w=@0 wn=first p=%1 c= ctx=main:1.2
session-window-changed sn=main s=sh w= wn= p= c= ctx=main:1.2
== command-error
command-error
== detach
pane-focus-out sn= s= w=@0 wn=first p=%1 c= ctx=main:1.2
client-detached sn= s= w= wn= p= c=<TTY> ctx=main:1.2
? 0
