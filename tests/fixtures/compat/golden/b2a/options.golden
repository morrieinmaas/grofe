update-environment[8] WINDOWID
update-environment[9] XAUTHORITY
update-environment[10] XDG_CURRENT_DESKTOP
update-environment[11] XDG_SESSION_DESKTOP
update-environment[12] XDG_SESSION_TYPE
visual-activity off
visual-bell off
visual-silence off
word-separators "!\"#$%&'()*+,-./:;<=>?@[\\]^`{|}~"
