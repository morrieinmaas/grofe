# B2a: the options tmux has that grofe used to reject. Each shows its
# default, takes a value of its kind, and fails on a bad one with tmux's
# words. Colour options are checked against names tmux and grofe share.
$ new-session -d -s main -x 80 -y 24 cat
$ show-options -gv assume-paste-time
$ set-option -g assume-paste-time 42
$ show-options -gv assume-paste-time
$ set-option -g assume-paste-time -1
$ set-option -g assume-paste-time x
$ show-options -gv destroy-unattached
$ show-options -gv display-panes-active-colour
$ set-option -g display-panes-active-colour green
$ show-options -gv display-panes-active-colour
$ set-option -g display-panes-active-colour '#0011Zz'
$ show-options -gv display-panes-colour
$ set-option -g display-panes-colour green
$ show-options -gv display-panes-colour
$ set-option -g display-panes-colour '#0011Zz'
$ show-options -gv display-panes-time
$ set-option -g display-panes-time 42
$ show-options -gv display-panes-time
$ set-option -g display-panes-time -1
$ set-option -g display-panes-time x
$ show-options -gv initial-repeat-time
$ set-option -g initial-repeat-time 42
$ show-options -gv initial-repeat-time
$ set-option -g initial-repeat-time -1
$ set-option -g initial-repeat-time x
$ show-options -gv key-table
$ set-option -g key-table 'x,y z'
$ show-options -gv key-table
