# TC.13 case 1a: canopy-agent's report path, as the claude-code adapter's
# hooks (adapters/claude-code/hooks.json) run it: report.sh reads the hook
# payload's session_id and calls `canopy-agent report <state>`, which
# reads the pane's three carried options in one display-message and
# writes all four in one `set -p ... \; set -p ...` chain, or nothing
# when none moved. One step per hook event, in a session's order, with
# the pane's options read back after each. The clock is the fixed one in
# tests/compat/scenarios/bin, so the timestamp is stable.
# Each tc_13 scenario starts the same way. The pins line is the golden's
# header: the canopy and athome commits it was recorded against (PINS).
# On tmux, canopy's own tmux entry point is sourced, with CANOPY_STORE set
# as canopy's installed stub sets it; on grofe that step does nothing,
# because the port (canopy's grofe/conf.d plus athome's config.toml and
# user.toml) is already loaded from XDG_CONFIG_HOME. main-pane-width is the
# one line of athome's user.conf the scenarios' layouts read.
$ new-session -d -s main -n main -x 200 -y 50 cat
$ display-message -p "pins: canopy 4faa58fff9d8 athome 6d3ee207afcc"
$ set-environment -g CANOPY_STORE {fixtures}/../../compat/scenarios/trees/canopy
$ source-file {fixtures}/../../compat/scenarios/trees/canopy/tmux/tmux.conf
$ setw -g main-pane-width 50%
# What a run-shell job sees of the server: the scripts reach the server
# through $TMUX, and canopy-agent reads $TMUX_PANE.
$ run-shell 'echo "TMUX ${TMUX:+set} TMUX_PANE ${TMUX_PANE:-unset}"'
# SessionStart, UserPromptSubmit, PreToolUse (no change: no write),
# Notification permission_prompt, Notification idle_prompt, Stop, a /clear
# (a new id at idle), SessionEnd.
$ run-shell 'echo "{\"session_id\":\"s-1\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh idle'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-1\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh working'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-1\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh working'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-1\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh blocked'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-1\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh completed'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-1\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh completed'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-2\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh idle'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ run-shell 'echo "{\"session_id\":\"s-2\"}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh exited'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
# A hook with no session id keeps the one the pane has.
$ run-shell 'echo "{}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh working'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
# Malformed calls: a state canopy does not know, a session id with shell
# syntax in it. report.sh swallows the first; canopy-agent refuses both.
$ run-shell 'echo "{}" | TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH {fixtures}/../../compat/scenarios/trees/canopy/adapters/claude-code/report.sh bogus; echo "report.sh exit $?"'
$ run-shell 'TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH sh {fixtures}/../../compat/scenarios/trees/canopy/bin/canopy-agent report bogus 2>&1; echo "exit $?"'
$ run-shell 'TMUX_PANE=%0 PATH={fixtures}/../../compat/scenarios/bin:$PATH sh {fixtures}/../../compat/scenarios/trees/canopy/bin/canopy-agent report idle --session-id "a;b" 2>&1; echo "exit $?"'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
# Outside a pane (no TMUX_PANE) the report is silent and writes nothing.
$ run-shell 'env -u TMUX_PANE PATH={fixtures}/../../compat/scenarios/bin:$PATH sh {fixtures}/../../compat/scenarios/trees/canopy/bin/canopy-agent report working; echo "exit $?"'
$ display-message -p -t %0 '#{@canopy_agent_state}|#{@canopy_agent_source}|#{@canopy_agent_session}|#{@canopy_agent_ts}'
$ show-options -p -t %0
