# TC.13 case 1b: canopy-status, the status line's one aggregator, run as
# its source runs it. The network and battery segments read the machine
# (the default route, a battery), so both are switched off with canopy's
# own options; the date and clock come from the fixed clock in tests/compat/scenarios/bin.
# What is left is canopy's rendering: plain, and as pills drawn from the
# theme options canopy's status layer sets.
# Each tc_13 scenario starts the same way. The pins line is the golden's
# header: the canopy and athome commits it was recorded against (PINS).
# On tmux, canopy's own tmux entry point is sourced, with CANOPY_STORE set
# as canopy's installed stub sets it; on grofe that step does nothing,
# because the port (canopy's grofe/conf.d plus athome's config.toml and
# user.toml) is already loaded from XDG_CONFIG_HOME. main-pane-width is the
# one line of athome's user.conf the scenarios' layouts read.
$ new-session -d -s main -n main -x 200 -y 50 cat
$ display-message -p "pins: canopy 4faa58fff9d8 athome 905f10a0b057"
$ set-environment -g CANOPY_STORE {fixtures}/../../compat/scenarios/trees/canopy
$ source-file {fixtures}/../../compat/scenarios/trees/canopy/tmux/tmux.conf
$ setw -g main-pane-width 50%
$ set -g @canopy_status_net off
$ set -g @canopy_status_battery off
$ run-shell 'PATH={fixtures}/../../compat/scenarios/bin:$PATH sh {fixtures}/../../compat/scenarios/trees/canopy/bin/canopy-status --plain'
$ run-shell 'PATH={fixtures}/../../compat/scenarios/bin:$PATH sh {fixtures}/../../compat/scenarios/trees/canopy/bin/canopy-status'
$ display-message -p '#{@theme_bg}|#{@theme_blue}|#{@theme_green}|#{@theme_grey}|#{@theme_red}|#{@pill_l}|#{@pill_r}'
$ run-shell 'PATH={fixtures}/../../compat/scenarios/bin:$PATH sh {fixtures}/../../compat/scenarios/trees/canopy/bin/canopy-status --wide 2>&1; echo "exit $?"'
