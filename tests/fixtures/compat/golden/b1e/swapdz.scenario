# swap-pane -d and -Z (tmux 3.7b cmd-swap-pane.c).
$ new-session -d -s main -x 200 -y 50 cat
$ split-window -h -t main cat
$ split-window -v -t main cat
$ new-window -t main cat
$ split-window -h -t main:2 cat
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -d, neither pane active: nothing changes.
$ swap-pane -d -s main:1.1 -t main:1.2
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -d, the source active.
$ select-pane -t main:1.1
$ swap-pane -d -s main:1.1 -t main:1.3
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -d, the target active.
$ select-pane -t main:1.2
$ swap-pane -d -t main:1.2 -s main:1.1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# without -d the target becomes active.
$ swap-pane -s main:1.1 -t main:1.3
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -d across windows, then without.
$ select-pane -t main:1.1
$ select-pane -t main:2.1
$ swap-pane -d -s main:1.1 -t main:2.2
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
$ swap-pane -s main:1.2 -t main:2.1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# a zoomed window unzooms on a swap.
$ resize-pane -Z -t main:1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
$ swap-pane -s main:1.1 -t main:1.2
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -Z keeps it zoomed, on the active pane.
$ resize-pane -Z -t main:1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
$ swap-pane -Z -s main:1.1 -t main:1.3
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
$ swap-pane -Z -d -s main:1.2 -t main:1.3
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -Z, one window of two zoomed.
$ swap-pane -Z -s main:1.1 -t main:2.1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
# -Z with nothing zoomed zooms nothing.
$ resize-pane -Z -t main:1
$ swap-pane -Z -s main:1.1 -t main:1.2
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
$ swap-pane -Z -D -t main:1.1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
$ swap-pane -d -Z -U -t main:2.1
$ list-panes -a -F '#{window_index}.#{pane_index} #{pane_id} act=#{pane_active} z=#{window_zoomed_flag} #{pane_width}x#{pane_height}'
