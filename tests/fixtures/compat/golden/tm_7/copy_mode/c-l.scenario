# TM.7 parity, copy-mode-vi `C-l` (select-pane -R): from the left pane to the right. The fixture
# is TM.1's 500 lines of history in 80x24 with copy-mode.conf sourced;
# grofe runs it through the tmux symlink, tmux 3.7b in TC.0b's container.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/../copy/fixture.txt; tmux wait-for -S ready; exec sleep 100000'
$ wait-for ready
$ source-file {fixtures}/copy-mode.conf
$ split-window -h -t main 'exec sleep 100000'
$ split-window -v -t main 'exec sleep 100000'
$ select-pane -t main:1.1
$ copy-mode -t main:1.1
$ list-panes -t main -F '#{pane_index} #{pane_active} #{pane_in_mode}'
$ send-keys -t main C-l
$ list-panes -t main -F '#{pane_index} #{pane_active} #{pane_in_mode}'
