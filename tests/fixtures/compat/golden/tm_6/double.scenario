# TM.6 case 4: a double click selects the word under the pointer with the
# default word-separators and copies it after 0.3 s (the stock root row:
# copy-mode -H, select-word, run-shell -d 0.3, copy-pipe-and-cancel), on
# each kind of column of 'line 478: foo.bar(baz) qux-quux, ...'; then in
# copy mode (copy-mode-vi's DoubleClick1Pane).
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/../copy/fixture.txt; if [ -n "$GROFE" ]; then {grofe} wait-for -S ready; else tmux wait-for -S ready; fi; exec sleep 100000'
$ wait-for ready
client 80x25 attach -t main
keys Escape '[<0;3;1M' Escape '[<0;3;1m' Escape '[<0;3;1M' Escape '[<0;3;1m'
$ run-shell 'sleep 1'
$ display -p -t main '#{pane_in_mode}'
$ show-buffer
$ list-buffers -F '#{buffer_name} #{buffer_size}'
$ delete-buffer
