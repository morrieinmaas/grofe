# TM.1: vertical motions, scrolling and paging (k j Up Down C-y K C-Up C-e
# J C-Down H M L z g G C-u C-d C-b C-f PPage NPage P), each followed by the
# cursor readout, over tests/fixtures/copy/fixture.txt in an 80x24 pane
# with 500 lines of history. Counts through -N; the column sticks to the
# end of a line as tmux's lastcx does.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/../copy/fixture.txt; exec sleep 100000'
$ run-shell 'sleep 1'
$ copy-mode -t main
$ send-keys -t main k
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position}'
$ send-keys -t main k
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position}'
$ send-keys -t main Up
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position}'
$ send-keys -t main j
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position}'
$ send-keys -t main Down
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position}'
$ send-keys -t main -N 5 -X cursor-up
$ display -p -t main '#{copy_cursor_x},#{copy_cursor_y},#{scroll_position}'
