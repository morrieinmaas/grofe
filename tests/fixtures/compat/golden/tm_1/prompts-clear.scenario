# G1: what clears OSC 133 marks. tmux 3.7b resets a line's flags when a whole
# line is cleared (a line with no cells yet is left alone by EL 0 and EL 2
# from column 0), keeps them for a partial clear, moves them with the line
# into history when ED 2 scrolls the screen up, and keeps the screen's flags
# when ED 3 drops the history. Each case is its own session; the marks are
# read back with previous-prompt from the end of the history.
# case 1: EL 0 at column 0 of a line with no cells keeps the mark
$ new-session -d -s c1 -x 20 -y 6 'printf "\033]133;A\007\033[Kab\n\033]133;A\007cd\n"; if [ -n "$GROFE" ]; then {grofe} wait-for -S c1; else tmux wait-for -S c1; fi; exec sleep 100000'
$ wait-for c1
$ copy-mode -t c1
$ send-keys -t c1 -X history-bottom
$ send-keys -t c1 -X previous-prompt
$ display -p -t c1 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c1 -X previous-prompt
$ display -p -t c1 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c1 -X previous-prompt
$ display -p -t c1 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c1 -X previous-prompt
$ display -p -t c1 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c1 -X previous-prompt
$ display -p -t c1 '#{history_size} #{copy_cursor_y},#{scroll_position}'
# case 2: EL 0 at column 0 of a line with cells resets it
$ new-session -d -s c2 -x 20 -y 6 'printf "abc\r\033]133;A\007\033[Kxy\n\033]133;A\007cd\n"; if [ -n "$GROFE" ]; then {grofe} wait-for -S c2; else tmux wait-for -S c2; fi; exec sleep 100000'
$ wait-for c2
$ copy-mode -t c2
$ send-keys -t c2 -X history-bottom
$ send-keys -t c2 -X previous-prompt
$ display -p -t c2 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c2 -X previous-prompt
$ display -p -t c2 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c2 -X previous-prompt
$ display -p -t c2 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c2 -X previous-prompt
$ display -p -t c2 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c2 -X previous-prompt
$ display -p -t c2 '#{history_size} #{copy_cursor_y},#{scroll_position}'
