$ send-keys -t c3 -X previous-prompt
$ display -p -t c3 '#{history_size} #{copy_cursor_y},#{scroll_position}'
$ send-keys -t c3 -X previous-prompt
$ display -p -t c3 '#{history_size} #{copy_cursor_y},#{scroll_position}'
