# TM.1: the navigator's copy-mode rows (C-h C-j C-k C-l C-\ to
# select-pane), bound as canopy's port binds them: each moves to the
# neighbouring pane and every pane keeps its copy mode.
$ new-session -d -s main -x 80 -y 24 'cat {fixtures}/../copy/fixture.txt; exec sleep 100000'
$ split-window -h -t main 'exec sleep 100000'
$ split-window -v -t main 'exec sleep 100000'
$ bind-key -T copy-mode-vi C-h select-pane -L
$ bind-key -T copy-mode-vi C-j select-pane -D
$ bind-key -T copy-mode-vi C-k select-pane -U
$ bind-key -T copy-mode-vi C-l select-pane -R
$ bind-key -T copy-mode-vi 'C-\' select-pane -l
$ copy-mode -t main:1.1
$ copy-mode -t main:1.2
$ copy-mode -t main:1.3
$ display -p -t main '#{pane_index}'
$ send-keys -t main C-h
$ display -p -t main '#{pane_index}'
$ send-keys -t main C-l
$ display -p -t main '#{pane_index}'
$ send-keys -t main C-j
$ display -p -t main '#{pane_index}'
$ send-keys -t main C-k
$ display -p -t main '#{pane_index}'
$ send-keys -t main 'C-\'
$ display -p -t main '#{pane_index}'
$ list-panes -t main -F '#{pane_index} #{pane_in_mode} #{pane_mode}'
