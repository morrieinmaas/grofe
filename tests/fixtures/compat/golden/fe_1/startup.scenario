# FE.1: -f and start-server. `-f` names the only config of the server it
# starts; a missing file is no config and no error, as is /dev/null.
# `start-server` runs the rest of its chain (TPM's
# `start-server \; show-option -gqv @tpm_plugins`).
$ -f /nonexistent/grofe-fe1.conf start-server \; set -g @x 1 \; show -gv @x
$ start-server \; show -gqv @tpm_plugins
$ -f /dev/null new-session -d -s main -x 200 -y 50
$ has-session -t main
$ -f missing-fe1.conf new-session -d -s rel -x 200 -y 50
$ has-session -t rel
