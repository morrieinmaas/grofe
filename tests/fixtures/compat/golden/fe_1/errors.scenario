# FE.1: tmux's error texts for tmux-dialect requests, and opensessions'
# `select-pane -P <style>` (M36-R4): tmux 3.7b still takes the hidden -P,
# selects the pane and sets its style.
$ new-session -d -s main -x 200 -y 50
$ split-window -d -t main cat
$ display -p -t main '#{pane_index}'
$ select-pane -P bg=colour238 -t main:1.2
$ display -p -t main '#{pane_index}'
$ select-pane -t main -P
$ select-pane -Z -q
$ kill-session -t
$ kill-server extra
$ has-session -t nope
$ select-window -t main:9
