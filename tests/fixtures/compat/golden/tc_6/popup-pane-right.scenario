# TC.6 (M36-R5): -x R -y P fired without the mouse, as which-key opens its
# popups: the box's right edge on the current pane's, its bottom on the
# pane's bottom.
$ new-session -d -s main -n first -x 60 -y 15 cat
$ source-file {fixtures}/tmux-status-noclock.conf
$ split-window -h -l 25 -t main cat
$ select-pane -t main:1.1
client 60x15 attach -t main
$& display-popup -c {client} -x R -y P -w 20 -h 5 "echo RP; exec cat"
screen RP
