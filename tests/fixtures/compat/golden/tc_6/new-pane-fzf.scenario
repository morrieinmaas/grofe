# TC.6 (M36-R1, M36-R2): fzf 0.74's --tmux form of new-pane, a tmux 3.7
# floating pane: -x/-y its size, -X/-Y its window cell, the border around
# it. -P -F prints its id.
$ new-session -d -s main -n first -x 60 -y 15 cat
$ source-file {fixtures}/tmux-status-noclock.conf
client 60x15 attach -t main
$ new-pane -P -F #{pane_id} -t main:1.1 -c /tmp -x 30 -y 8 -X 5 -Y 3 sh -c "echo in-np; exec cat"
screen in-np
$ list-panes -t main -F "#{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_height} #{pane_floating_flag}"
