# TC.13 regression: #{pane_at_left}, #{pane_at_right}, #{pane_at_top} and
# #{pane_at_bottom}, which the navigator's no-wrap mode reads: 1 when the
# pane touches that edge of the window, as format.c decides it, and in a
# zoomed window. (grofe has no pane-border-status, which moves the top and
# bottom edges in tmux.)
$ new-session -d -s main -x 80 -y 24
$ split-window -d -h -t main:1.1
$ split-window -d -v -t main:1.2
$ list-panes -t main:1 -F '#{pane_index} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} L#{pane_at_left} R#{pane_at_right} T#{pane_at_top} B#{pane_at_bottom}'
$ resize-pane -Z -t main:1.3
$ list-panes -t main:1 -F '#{pane_index} #{pane_left},#{pane_top} #{pane_width}x#{pane_height} L#{pane_at_left} R#{pane_at_right} T#{pane_at_top} B#{pane_at_bottom}'
$ display -p -t main:1.3 '#{pane_at_left}#{pane_at_right}#{pane_at_top}#{pane_at_bottom}'
