# B1b: tmux 3.7b's format modifiers beyond the comparison set, through
# display -p against a fixed model: session main (windows first with two
# panes, second), session other. display -p runs strftime over the whole
# template first, so every % is doubled; the `t/f` forms run through
# list-windows -F, which does not. Modifier chains (`;`), arguments with
# any delimiter, and the error forms are in the same file.
$ new-session -d -s main -n first -x 80 -y 24 cat -u
$ split-window -d -t main:1 cat -u
$ new-window -d -t main -n second cat -u
$ new-session -d -s other -n solo -x 80 -y 24 cat -u
$ set -g @opt value
$ set -g @path /usr/local/bin/tool/
$ set -g @wide 日本語ab
$ set -g @f '#{session_name}-100%%'
$ set -g @nest '#{@opt}!'
$ set -g @ts 1700049600
$ set -g @csv 'a,b'
$ set -g @num 12
$ set -g @empty ''
$ set -g @root /
$ set -g @bare tool
# trimming
$ display -p -t main:1.1 '[#{=3:session_name}]'
$ display -p -t main:1.1 '[#{=-3:session_name}]'
$ display -p -t main:1.1 '[#{=0:session_name}]'
$ display -p -t main:1.1 '[#{=10:session_name}]'
$ display -p -t main:1.1 '[#{=x:session_name}]'
$ display -p -t main:1.1 '[#{=/3/...:session_name}]'
$ display -p -t main:1.1 '[#{=/-3/...:session_name}]'
$ display -p -t main:1.1 '[#{=/10/...:session_name}]'
$ display -p -t main:1.1 '[#{=/3/:session_name}]'
$ display -p -t main:1.1 '[#{=|3|~~:session_name}]'
$ display -p -t main:1.1 '[#{=3:@wide}]'
$ display -p -t main:1.1 '[#{=4:@wide}]'
$ display -p -t main:1.1 '[#{=-3:@wide}]'
$ display -p -t main:1.1 '[#{=#{@num}:session_name}]'
$ display -p -t main:1.1 '[#{=2:#{@opt}}]'
$ display -p -t main:1.1 '[#{=2:@nest}]'
# padding
$ display -p -t main:1.1 '[#{p8:session_name}]'
$ display -p -t main:1.1 '[#{p-8:session_name}]'
$ display -p -t main:1.1 '[#{p2:session_name}]'
$ display -p -t main:1.1 '[#{p0:session_name}]'
$ display -p -t main:1.1 '[#{p8:@wide}]'
$ display -p -t main:1.1 '[#{p:session_name}]'
$ display -p -t main:1.1 '[#{p6:#{@opt}}]'
# length and width
$ display -p -t main:1.1 '[#{n:session_name}]'
$ display -p -t main:1.1 '[#{n:@wide}]'
$ display -p -t main:1.1 '[#{w:@wide}]'
$ display -p -t main:1.1 '[#{w:session_name}]'
$ display -p -t main:1.1 '[#{n:nosuchvar}]'
$ display -p -t main:1.1 '[#{n:#{@opt}}]'
# substitution
$ display -p -t main:1.1 '[#{s/a/A/:session_name}]'
$ display -p -t main:1.1 '[#{s/A/x/i:session_name}]'
$ display -p -t main:1.1 '[#{s/A/x/:session_name}]'
$ display -p -t main:1.1 '[#{s/a|i/_/:session_name}]'
$ display -p -t main:1.1 '[#{s/(m)(a)/\2\1/:session_name}]'
$ display -p -t main:1.1 '[#{s/(m)/<\0>/:session_name}]'
$ display -p -t main:1.1 '[#{s/x*/-/:session_name}]'
$ display -p -t main:1.1 '[#{s/^m/M/:session_name}]'
$ display -p -t main:1.1 '[#{s/n$/N/:session_name}]'
$ display -p -t main:1.1 '[#{s|a|b|:session_name}]'
$ display -p -t main:1.1 '[#{s,a,b,:session_name}]'
$ display -p -t main:1.1 '[#{s/a/A/;s/i/I/:session_name}]'
$ display -p -t main:1.1 '[#{s/a/b/;s/b/c/:session_name}]'
$ display -p -t main:1.1 '[#{s/a/A:session_name}]'
$ display -p -t main:1.1 '[#{s/a:session_name}]'
$ display -p -t main:1.1 '[#{s/(/x/:session_name}]'
$ display -p -t main:1.1 '[#{s//x/:session_name}]'
$ display -p -t main:1.1 '[#{s/a//:session_name}]'
$ display -p -t main:1.1 '[#{s/#{@opt}/Z/:@opt}]'
$ display -p -t main:1.1 '[#{s/a/A/:nosuchvar}]'
# chains
$ display -p -t main:1.1 '[#{=2;p5:session_name}]'
$ display -p -t main:1.1 '[#{s/a/A/;=2:session_name}]'
$ display -p -t main:1.1 '[#{=-2;p-5:session_name}]'
$ display -p -t main:1.1 '[#{n;p3:session_name}]'
$ display -p -t main:1.1 '[#{p3;n:session_name}]'
$ display -p -t main:1.1 '[#{s/a/AA/;n:session_name}]'
# paths
$ display -p -t main:1.1 '[#{b:@path}]'
$ display -p -t main:1.1 '[#{d:@path}]'
$ display -p -t main:1.1 '[#{d:session_path}]'
$ display -p -t main:1.1 '[#{b;=2:@path}]'
$ display -p -t main:1.1 '[#{d;b:@path}]'
$ display -p -t main:1.1 '[#{d:nosuchvar}]'
$ display -p -t main:1.1 '[#{b:@empty}][#{d:@empty}][#{b:@root}][#{d:@root}][#{b:@bare}][#{d:@bare}]'
# arithmetic
$ display -p -t main:1.1 '[#{e|+:3,4}]'
$ display -p -t main:1.1 '[#{e|-:3,4}]'
$ display -p -t main:1.1 '[#{e|*:3,4}]'
$ display -p -t main:1.1 '[#{e|/:7,2}]'
$ display -p -t main:1.1 '[#{e|m:7,2}]'
$ display -p -t main:1.1 '[#{e|%:7,2}]'
$ display -p -t main:1.1 '[#{e|/|f:7,2}]'
$ display -p -t main:1.1 '[#{e|/|f|4:7,3}]'
$ display -p -t main:1.1 '[#{e|+|f:1.5,2.25}]'
$ display -p -t main:1.1 '[#{e|+:1.5,2.25}]'
$ display -p -t main:1.1 '[#{e|*|f|0:1.5,3}]'
$ display -p -t main:1.1 '[#{e|==:1,1}]'
$ display -p -t main:1.1 '[#{e|!=:1,1}]'
$ display -p -t main:1.1 '[#{e|>:3,2}]'
$ display -p -t main:1.1 '[#{e|>=:2,2}]'
$ display -p -t main:1.1 '[#{e|<:3,2}]'
$ display -p -t main:1.1 '[#{e|<=:2,3}]'
$ display -p -t main:1.1 '[#{e|==|f:0.1,0.1}]'
$ display -p -t main:1.1 '[#{e|+:#{@num},#{@num}}]'
$ display -p -t main:1.1 '[#{e|+:x,1}]'
$ display -p -t main:1.1 '[#{e|+:1}]'
$ display -p -t main:1.1 '[#{e|?:1,2}]'
$ display -p -t main:1.1 '[#{e|/|f:1,0}]'
$ display -p -t main:1.1 '[#{e|-:-3,-4}]'
$ display -p -t main:1.1 '[#{e|+|f|2:1e2,1}]'
$ display -p -t main:1.1 '[#{e|+|f|-1:1,1}]'
$ display -p -t main:1.1 '[#{e|+|f|abc:1,1}]'
$ display -p -t main:1.1 '[#{e|+|x:1,2}]'
$ display -p -t main:1.1 '[#{e|+|f|3|9:1,2}]'
$ display -p -t main:1.1 '[#{e|+:#{e|*:2,3},4}]'
$ display -p -t main:1.1 '[#{e|*:2,3;=1:4}]'
# characters and colours
$ display -p -t main:1.1 '[#{a:65}]'
$ display -p -t main:1.1 '[#{a:126}]'
$ display -p -t main:1.1 '[#{a:127}]'
$ display -p -t main:1.1 '[#{a:31}]'
$ display -p -t main:1.1 '[#{a:x}]'
$ display -p -t main:1.1 '[#{a:#{e|+:60,5}}]'
$ display -p -t main:1.1 '[#{c:red}]'
$ display -p -t main:1.1 '[#{c:#336699}]'
$ display -p -t main:1.1 '[#{c:colour39}]'
$ display -p -t main:1.1 '[#{c:colour200}]'
$ display -p -t main:1.1 '[#{c:3}]'
$ display -p -t main:1.1 '[#{c:default}]'
$ display -p -t main:1.1 '[#{c:nonsense}]'
$ display -p -t main:1.1 '[#{c:brightred}]'
$ display -p -t main:1.1 '[#{c:#{@opt}}]'
$ display -p -t main:1.1 '[#{c:grey50}][#{c:gray}][#{c:grey101}][#{c:orange}][#{c:Dark Orange}][#{c:colour256}][#{c:#12345}]'
$ display -p -t main:1.1 '[#{c:brightblack}][#{c:90}][#{c:7}][#{c:8}][#{c:terminal}][#{c:COLOUR9}][#{c:color5}]'
# searching a pane's screen
$ send-keys -t main:1.1 needle Enter
$ run-shell 'sleep 0.5'
$ display -p -t main:1.1 '[#{C:needle}][#{C:need}][#{C/i:NEED}][#{C:NEED}][#{C/r:^ne+dle$}][#{C/ri:^NE+DLE$}][#{C:zzz}][#{C/r:(}][#{C:}]'
$ display -p -t main:1.2 '[#{C:needle}]'
$ display -p -t main:1.1 '[#{C:#{@opt}}][#{C;=1:needle}]'
# repeat
$ display -p -t main:1.1 '[#{R:ab,3}]'
$ display -p -t main:1.1 '[#{R:ab,0}]'
$ display -p -t main:1.1 '[#{R:ab,x}]'
$ display -p -t main:1.1 '[#{R:#{@opt},2}]'
$ display -p -t main:1.1 '[#{R:-,#{@num}}]'
$ display -p -t main:1.1 '[#{R:ab}]'
# names
$ display -p -t main:1.1 '[#{N:first}]'
$ display -p -t main:1.1 '[#{N:nope}]'
$ display -p -t main:1.1 '[#{N/w:second}]'
$ display -p -t main:1.1 '[#{N/s:main}]'
$ display -p -t main:1.1 '[#{N/s:first}]'
$ display -p -t main:1.1 '[#{N/s:other}]'
$ display -p -t main:1.1 '[#{N/w:solo}]'
$ display -p -t main:1.1 '[#{N/x:main}]'
$ display -p -t main:1.1 '[#{N:#{window_name}}]'
# expand and expand-time
$ display -p -t main:1.1 '[#{E:@nest}]'
$ display -p -t main:1.1 '[#{@nest}]'
$ display -p -t main:1.1 '[#{E:@opt}]'
$ display -p -t main:1.1 '[#{T:@f}]'
$ display -p -t main:1.1 '[#{T:@nest}]'
$ display -p -t main:1.1 '[#{E;=3:@nest}]'
$ display -p -t main:1.1 '[#{E:nosuchvar}]'
$ display -p -t main:1.1 '[#{T:session_name}]'
# quoting
$ display -p -t main:1.1 '[#{q:@spaced}]'
$ set -g @spaced 'a b|c#d'
$ display -p -t main:1.1 '[#{q:@spaced}]'
$ display -p -t main:1.1 '[#{q/e:@spaced}]'
$ display -p -t main:1.1 '[#{q/h:@spaced}]'
$ display -p -t main:1.1 '[#{q/a:@spaced}]'
$ display -p -t main:1.1 '[#{q/x:@spaced}]'
$ display -p -t main:1.1 '[#{q/eh:@spaced}]'
$ display -p -t main:1.1 '[#{q;=3:@spaced}]'
$ display -p -t main:1.1 '[#{q:#{@spaced}}]'
# times
$ list-windows -t other -F '[#{t:@ts}]'
$ list-windows -t other -F '[#{t/f/%Y:@ts}]'
$ list-windows -t other -F '[#{t/f/%Y-%j:@ts}]'
$ list-windows -t other -F '[#{t/p:@ts}]'
$ list-windows -t other -F '[#{t/f:@ts}]'
$ list-windows -t other -F '[#{t/x:@ts}]'
$ list-windows -t other -F '[#{t:@opt}]'
$ list-windows -t other -F '[#{t:nosuchvar}]'
$ list-windows -t other -F '[#{t/f/%Y|=4:@ts}]'
$ list-windows -t other -F '[#{t/f|%Y|:@ts}]'
# chained and boolean forms with the new parser
$ display -p -t main:1.1 '[#{&&;!:1,0}]'
$ display -p -t main:1.1 '[#{||:0,0,1}]'
$ display -p -t main:1.1 '[#{!;!:1}]'
$ display -p -t main:1.1 '[#{==;p5:a,a}]'
$ display -p -t main:1.1 '[#{m;=2:a*,abc}]'
$ display -p -t main:1.1 '[#{m/i:A*,abc}]'
$ display -p -t main:1.1 '[#{?#{N:first},yes,no}]'
$ display -p -t main:1.1 '[#{=2;?1,abc,def}]'
$ display -p -t main:1.1 '[#{=2:#{?1,abc,def}}]'
# the parser's edges
$ display -p -t main:1.1 '[#{;:session_name}]'
$ display -p -t main:1.1 '[#{=3;:session_name}]'
$ display -p -t main:1.1 '[#{=3;;=2:session_name}]'
$ display -p -t main:1.1 '[#{=3 :session_name}]'
$ display -p -t main:1.1 '[#{X:session_name}]'
$ display -p -t main:1.1 '[#{=3,session_name}]'
$ display -p -t main:1.1 '[#{p5;:session_name}]'
$ display -p -t main:1.1 '[#{=/3/x/y:session_name}]'
$ display -p -t main:1.1 '[#{=/3:session_name}]'
$ display -p -t main:1.1 '[#{s/a/b/x/y:session_name}]'
$ display -p -t main:1.1 '[#{=3#,x:session_name}]'
$ display -p -t main:1.1 '[#{=/3/a#,b:session_name}]'
$ display -p -t main:1.1 '[#{s/#//:session_name}]'
$ display -p -t main:1.1 '[#{s/a/#,/:session_name}]'
$ display -p -t main:1.1 '[#{l:#{x}}]'
$ display -p -t main:1.1 '[#{l;=1:#{x}}]'
$ display -p -t main:1.1 '[#{E:l:#{@opt}}]'
